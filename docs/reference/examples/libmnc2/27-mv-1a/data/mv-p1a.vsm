# mv-p1a.vsm — Pattern 1A: PDM@0 → PDM@0~3 via 3x individual mvp (3.5.8.8)
#
# 動作:
#   Scatter: PDM@G0[0..63] → PDM@G1/2/3[0..63] (3.5.8.8)
#   Gather step1: PDM@G1/2/3[0..63] → DRAM@G1/2/3 (3.5.8.2)
#   Gather step2: DRAM@G1/2/3 → PDM@G0[64..255] (3.5.8.3) ← recv trigger
# 結果: PDM@G0[0..255] = 4 copies of source block0
# DMA: send_wait_tag=2, recv_wait_tag=6

	nop; wait i02
	nop/3
	# Scatter: PDM@G0[0..63] → PDM@G1/2/3[0..63] (3.5.8.8)
	mvp/n64 $p0@0 $p0@1
	mvp/n64 $p0@0 $p0@2
	mvp/n64i01 $p0@0 $p0@3
	nop/2
	nop; wait i01
	nop/5
	# Gather step1: PDM@G1/2/3[0..63] → DRAM@G1/2/3[0..63] (3.5.8.2)
	mvp/n64 $p0@1 $d0@1
	mvp/n64 $p0@2 $d0@2
	mvp/n64i03 $p0@3 $d0@3
	nop/2
	nop; wait i03
	nop/5
	# Gather step2: DRAM@G1/2/3 → PDM@G0[64..255] (3.5.8.3) → recv trigger
	mvp/n64 $d0@1 $p64@0
	mvp/n64 $d0@2 $p128@0
	mvp/n64i06 $d0@3 $p192@0
	nop/2
	nop; wait i06
	nop/5
	# pseudo ret
