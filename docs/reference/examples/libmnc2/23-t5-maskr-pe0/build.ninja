# build.ninja — 23-t5-maskr-pe0
include ../../scripts/sdk.ninja
include ../../scripts/examples.ninja

# カーネル
build $builddir/t5_maskr_pe0.asm: asm3_text data/t5_maskr_pe0.vsm
build $builddir/t5_maskr_pe0.idma.dat: asm3_loader data/t5_maskr_pe0.vsm
  stem = $builddir/t5_maskr_pe0

# test driver
build $builddir/ex_t5_maskr_pe0.o: cc ex_t5_maskr_pe0.c
build $builddir/ex_t5_maskr_pe0: link $builddir/ex_t5_maskr_pe0.o | ${sdk_root}/lib/libmnc2.a

# test targets
build test-emu:     test_emu_process $builddir/ex_t5_maskr_pe0 | $builddir/t5_maskr_pe0.asm $builddir/t5_maskr_pe0.idma.dat
build test-emu-lib: test_emu_lib     $builddir/ex_t5_maskr_pe0 | $builddir/t5_maskr_pe0.asm $builddir/t5_maskr_pe0.idma.dat
build test-device:  test_device      $builddir/ex_t5_maskr_pe0 | $builddir/t5_maskr_pe0.asm $builddir/t5_maskr_pe0.idma.dat
build test:         test_usage

default $builddir/ex_t5_maskr_pe0 $builddir/t5_maskr_pe0.asm $builddir/t5_maskr_pe0.idma.dat
