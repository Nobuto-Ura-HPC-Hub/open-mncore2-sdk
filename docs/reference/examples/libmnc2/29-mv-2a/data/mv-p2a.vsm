# mv-p2a.vsm — Pattern 2A: PDM@0 → DRAM@0~3 via 4x individual mvp (3.5.8.2)
#
# 動作:
#   PDM group0[0..63] → DRAM@G[0..63] for G=0,1,2,3 (同じデータを全 DRAM に)
#   Gather back: DRAM@G[0..63] → PDM@0[G*64..G*64+63]
# 結果: PDM@0[0..255] = 4 copies of source (DRAM 経由ラウンドトリップ)
# DMA: send_wait_tag=2, recv_wait_tag=6

	nop; wait i02
	nop/3
	# PDM group0 → DRAM@G (same source data to all groups' DRAM)
	mvp/n64 $p0@0 $d0@0
	mvp/n64 $p0@0 $d0@1
	mvp/n64 $p0@0 $d0@2
	mvp/n64i01 $p0@0 $d0@3
	nop/2
	nop; wait i01
	nop/5
	# Gather back: DRAM@G → PDM@0[G*64..G*64+63]
	mvp/n64 $d0@0 $p0@0
	mvp/n64 $d0@1 $p64@0
	mvp/n64 $d0@2 $p128@0
	mvp/n64i06 $d0@3 $p192@0
	nop/2
	nop; wait i06
	nop/5
	# pseudo ret
