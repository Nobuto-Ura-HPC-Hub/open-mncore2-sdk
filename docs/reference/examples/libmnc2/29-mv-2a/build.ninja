# build.ninja — 29-mv-2a
include ../../scripts/sdk.ninja
include ../../scripts/examples.ninja

# カーネル
build $builddir/mv-p2a.asm: asm3_text data/mv-p2a.vsm
build $builddir/mv-p2a.idma.dat: asm3_loader data/mv-p2a.vsm
  stem = $builddir/mv-p2a

# test driver
build $builddir/ex_mv_2a.o: cc ex_mv_2a.c
build $builddir/ex_mv_2a: link $builddir/ex_mv_2a.o | ${sdk_root}/lib/libmnc2.a

# test targets
build test-emu:     test_emu_process $builddir/ex_mv_2a | $builddir/mv-p2a.asm $builddir/mv-p2a.idma.dat
build test-emu-lib: test_emu_lib     $builddir/ex_mv_2a | $builddir/mv-p2a.asm $builddir/mv-p2a.idma.dat
build test-device:  test_device      $builddir/ex_mv_2a | $builddir/mv-p2a.asm $builddir/mv-p2a.idma.dat
build test:         test_usage

default $builddir/ex_mv_2a $builddir/mv-p2a.asm $builddir/mv-p2a.idma.dat
