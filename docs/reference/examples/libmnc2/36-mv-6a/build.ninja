# build.ninja — 36-mv-6a
include ../../scripts/sdk.ninja
include ../../scripts/examples.ninja

# カーネル
build $builddir/mv-p6a.asm: asm3_text data/mv-p6a.vsm
build $builddir/mv-p6a.idma.dat: asm3_loader data/mv-p6a.vsm
  stem = $builddir/mv-p6a

# test driver
build $builddir/ex_mv_6a.o: cc ex_mv_6a.c
build $builddir/ex_mv_6a: link $builddir/ex_mv_6a.o | ${sdk_root}/lib/libmnc2.a

# test targets
build test-emu:     test_emu_process $builddir/ex_mv_6a | $builddir/mv-p6a.asm $builddir/mv-p6a.idma.dat
build test-emu-lib: test_emu_lib     $builddir/ex_mv_6a | $builddir/mv-p6a.asm $builddir/mv-p6a.idma.dat
build test-device:  test_device      $builddir/ex_mv_6a | $builddir/mv-p6a.asm $builddir/mv-p6a.idma.dat
build test:         test_usage

default $builddir/ex_mv_6a $builddir/mv-p6a.asm $builddir/mv-p6a.idma.dat
