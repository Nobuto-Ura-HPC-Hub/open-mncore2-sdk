# mv-p6a.vsm — Pattern 6A: PDM@0~3 ← DRAM@0~3 parallel via 4x individual mvp (3.5.8.3)
#
# 動作:
#   Setup:    PDM@G0[G*64..G*64+63] → DRAM@G[0..63] for G=0..3 (cross-group mvp)
#   Pattern6: DRAM@G[0..63] → PDM@G[0..63] for G=0..3 (各グループ自身の DRAM→PDM)
#   Gather step1: PDM@G1/2/3[0..63] → DRAM@G1/2/3 (3.5.8.2) (中継)
#   Gather step2: DRAM@G1/2/3 → PDM@G0[G*64..G*64+63] (3.5.8.3) ← recv trigger
#             G=0 は PDM@G0[0..63] に直接書き込み済み
# 入力: PDM@G0[0..255] = 4 ブロック
# 結果: PDM@G0[0..255] = roundtrip (元のデータ復元)
# DMA: send_wait_tag=2, recv_wait_tag=6

	nop; wait i02
	nop/3
	# Setup: PDM@G0[G*64] → DRAM@G (cross-group mvp, 3.5.8.2)
	mvp/n64 $p0@0 $d0@0
	mvp/n64 $p64@0 $d0@1
	mvp/n64 $p128@0 $d0@2
	mvp/n64i01 $p192@0 $d0@3
	nop/2
	nop; wait i01
	nop/5
	# Pattern 6: DRAM@G[0..63] → PDM@G[0..63] (4x individual, 3.5.8.3)
	mvp/n64 $d0@0 $p0@0
	mvp/n64 $d0@1 $p0@1
	mvp/n64 $d0@2 $p0@2
	mvp/n64i03 $d0@3 $p0@3
	nop/2
	nop; wait i03
	nop/5
	# Gather step1: PDM@G1/2/3[0..63] → DRAM@G1/2/3 (3.5.8.2)
	mvp/n64 $p0@1 $d0@1
	mvp/n64 $p0@2 $d0@2
	mvp/n64i04 $p0@3 $d0@3
	nop/2
	nop; wait i04
	nop/5
	# Gather step2: DRAM@G1/2/3 → PDM@G0[G*64..G*64+63] (3.5.8.3) → recv trigger
	mvp/n64 $d0@1 $p64@0
	mvp/n64 $d0@2 $p128@0
	mvp/n64i06 $d0@3 $p192@0
	nop/2
	nop; wait i06
	nop/5
	# pseudo ret
