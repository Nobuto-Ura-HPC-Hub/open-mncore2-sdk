# build.ninja — 59-pdm0-single-add (emu:lib / device、emu:process 非対応)
#
# 56/57/58 と並ぶベンチ系列の 4 例目。外部メモリ = PDM@0 のみ、PDM@0 ↔ L2BM
# の hop は mvp 単独個別 8 発で行う。58 (mvd 1+1) との直接比較対象。
# host C 側で emu:process を SKIP (exit 0)。
include ../../scripts/sdk.ninja
include ../../scripts/examples.ninja

build $builddir/distribute.asm: asm3_text data/distribute.vsm
build $builddir/distribute.idma.dat: asm3_loader data/distribute.vsm
  stem = $builddir/distribute

build $builddir/add1.asm: asm3_text data/add1.vsm
build $builddir/add1.idma.dat: asm3_loader data/add1.vsm
  stem = $builddir/add1

build $builddir/collect.asm: asm3_text data/collect.vsm
build $builddir/collect.idma.dat: asm3_loader data/collect.vsm
  stem = $builddir/collect

# test driver
build $builddir/ex_pdm0_single_add.o: cc ex_pdm0_single_add.c
build $builddir/ex_pdm0_single_add: link $builddir/ex_pdm0_single_add.o | ${sdk_root}/lib/libmnc2.a

build test:         test_usage_no_emu
build test-emu-lib: test_emu_lib     $builddir/ex_pdm0_single_add | $builddir/distribute.asm $builddir/distribute.idma.dat $builddir/add1.asm $builddir/add1.idma.dat $builddir/collect.asm $builddir/collect.idma.dat
build test-device:  test_device      $builddir/ex_pdm0_single_add | $builddir/distribute.asm $builddir/distribute.idma.dat $builddir/add1.asm $builddir/add1.idma.dat $builddir/collect.asm $builddir/collect.idma.dat

default $builddir/ex_pdm0_single_add $builddir/distribute.idma.dat $builddir/add1.idma.dat $builddir/collect.idma.dat
