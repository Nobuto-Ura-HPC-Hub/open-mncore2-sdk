# build.ninja — 33-mv-4a
include ../../scripts/sdk.ninja
include ../../scripts/examples.ninja

# カーネル
build $builddir/mv-p4a.asm: asm3_text data/mv-p4a.vsm
build $builddir/mv-p4a.idma.dat: asm3_loader data/mv-p4a.vsm
  stem = $builddir/mv-p4a

# test driver
build $builddir/ex_mv_4a.o: cc ex_mv_4a.c
build $builddir/ex_mv_4a: link $builddir/ex_mv_4a.o | ${sdk_root}/lib/libmnc2.a

# test targets
build test-emu:     test_emu_process $builddir/ex_mv_4a | $builddir/mv-p4a.asm $builddir/mv-p4a.idma.dat
build test-emu-lib: test_emu_lib     $builddir/ex_mv_4a | $builddir/mv-p4a.asm $builddir/mv-p4a.idma.dat
build test-device:  test_device      $builddir/ex_mv_4a | $builddir/mv-p4a.asm $builddir/mv-p4a.idma.dat
build test:         test_usage

default $builddir/ex_mv_4a $builddir/mv-p4a.asm $builddir/mv-p4a.idma.dat
