# fimm-f32-collect: f32 1.0 を imm + ALU フォワーディングで GRF に設定 → collect
#
# dev-manual p.66 の例に従い:
#   imm f"1.0" $nowrite       ← ALU で f32 即値を生成 (どこにも書かない)
#   lpassa $aluf $lr0         ← ALU 結果を GRF0 に書く
#
# DMA 送信なし。PE 内部で即値生成 → collect パスのみ。
# collect 先: PDM word 131072 (byte offset 1048576)
# recv_wait_tag: 0x1e (最終 mvp done flag)

	imm f"1.0" $nowrite
	lpassa $aluf $lr0
	nop/4
# GRF0 → LM0
	lpassa $lr0 $lm0
	nop/24
# LM0 → L1BM
	# 占有 L1BM [256, 512)。結合方向にはマスクが効かないため、
	# 4 cycle 分 256 u64 すべてが上書きされる。
	# 回収するのは cycle 0 の [256, 320) のみ。
	l1bmd $lm0v $lb256
	nop/24
	nop/24
# L1BM → L2BM
	l2bm@0 $lb256 $lc1024
	l2bm@1 $lb256 $lc1088
	l2bm@2 $lb256 $lc1152
	l2bm@3 $lb256 $lc1216
	l2bm@4 $lb256 $lc1280
	l2bm@5 $lb256 $lc1344
	l2bm@6 $lb256 $lc1408
	l2bm@7 $lb256 $lc1472
	nop/5
# L2BM → PDM (4 グループ × 512 u64)
	mvp/n512 $lc1024@0.0 $p131072@0
	mvp/n512i19 $lc1024@0.1 $p131584@0
	nop/3
	nop; wait i19
	mvp/n512 $lc1024@1.0 $p132096@0
	mvp/n512i1a $lc1024@1.1 $p132608@0
	nop/3
	nop; wait i1a
	mvp/n512 $lc1024@2.0 $p133120@0
	mvp/n512i1c $lc1024@2.1 $p133632@0
	nop/3
	nop; wait i1c
	mvp/n512 $lc1024@3.0 $p134144@0
	mvp/n512i1e $lc1024@3.1 $p134656@0
	nop/3
	nop; wait i1e
	nop/4
	# pseudo ret
