# build.ninja — 10-put-ln
# device テストは peek pipeline 方式 (07-put-l2bm/build.ninja のコメント参照)

include ../../scripts/sdk.ninja
include ../../scripts/examples.ninja

rule run_put_device
  command = LD_LIBRARY_PATH=${sdk_root}/lib ./$in
  description = RUN [device] put $in

rule run_peek_device
  command = ${sdk_root}/bin/run-idma $in --no-reset
  description = RUN [device] peek $in --no-reset

rule peek_check_device
  command = ${sdk_root}/bin/read-pdm 0 32 | od -An -v -tx8 --endian=little | diff - data/expected-peek.txt && echo "PASS: LM1[0..3] matches expected"
  description = CHECK [device] peek vs data/expected-peek.txt

build $builddir/put_ln.asm: asm3_text data/put_ln.vsm
build $builddir/put_ln.idma.dat: asm3_loader data/put_ln.vsm
  stem = $builddir/put_ln

build $builddir/peek_ln.asm: asm3_text data/peek_ln.vsm
build $builddir/peek_ln.idma.dat: asm3_loader data/peek_ln.vsm
  stem = $builddir/peek_ln

build $builddir/ex_put_ln.o: cc ex_put_ln.c
build $builddir/ex_put_ln: link $builddir/ex_put_ln.o | ${sdk_root}/lib/libmnc2.a

build test:         test_usage
build test-emu:     test_emu_process $builddir/ex_put_ln | $builddir/put_ln.asm $builddir/put_ln.idma.dat
build test-emu-lib: test_emu_lib     $builddir/ex_put_ln | $builddir/put_ln.asm $builddir/put_ln.idma.dat

build run-put-device: run_put_device $builddir/ex_put_ln | $builddir/put_ln.idma.dat
build run-peek-device: run_peek_device $builddir/peek_ln.idma.dat | run-put-device
build peek-check-device: peek_check_device | run-peek-device data/expected-peek.txt
build test-device: phony peek-check-device

default $builddir/ex_put_ln $builddir/put_ln.asm $builddir/put_ln.idma.dat $builddir/peek_ln.asm $builddir/peek_ln.idma.dat
