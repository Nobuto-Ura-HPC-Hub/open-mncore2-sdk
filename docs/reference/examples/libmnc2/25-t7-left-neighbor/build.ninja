# build.ninja — 25-t7-left-neighbor
include ../../scripts/sdk.ninja
include ../../scripts/examples.ninja

# カーネル
build $builddir/t7_left_neighbor.asm: asm3_text data/t7_left_neighbor.vsm
build $builddir/t7_left_neighbor.idma.dat: asm3_loader data/t7_left_neighbor.vsm
  stem = $builddir/t7_left_neighbor

# test driver
build $builddir/ex_t7_left_neighbor.o: cc ex_t7_left_neighbor.c
build $builddir/ex_t7_left_neighbor: link $builddir/ex_t7_left_neighbor.o | ${sdk_root}/lib/libmnc2.a

# test targets
build test-emu:     test_emu_process $builddir/ex_t7_left_neighbor | $builddir/t7_left_neighbor.asm $builddir/t7_left_neighbor.idma.dat
build test-emu-lib: test_emu_lib     $builddir/ex_t7_left_neighbor | $builddir/t7_left_neighbor.asm $builddir/t7_left_neighbor.idma.dat
build test-device:  test_device      $builddir/ex_t7_left_neighbor | $builddir/t7_left_neighbor.asm $builddir/t7_left_neighbor.idma.dat
build test:         test_usage

default $builddir/ex_t7_left_neighbor $builddir/t7_left_neighbor.asm $builddir/t7_left_neighbor.idma.dat
