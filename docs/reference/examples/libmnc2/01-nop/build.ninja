# build.ninja — nop example
include ../../scripts/sdk.ninja
include ../../scripts/examples.ninja

# カーネル (data/nop.vsm → _build/)
build $builddir/nop.asm: asm3_text data/nop.vsm
build $builddir/nop.idma.dat: asm3_loader data/nop.vsm
  stem = $builddir/nop

# test driver
build $builddir/ex_nop.o: cc ex_nop.c
build $builddir/ex_nop: link $builddir/ex_nop.o | ${sdk_root}/lib/libmnc2.a

# test targets
build test-emu:     test_emu_process $builddir/ex_nop | $builddir/nop.asm $builddir/nop.idma.dat
build test-emu-lib: test_emu_lib     $builddir/ex_nop | $builddir/nop.asm $builddir/nop.idma.dat
build test-device:  test_device      $builddir/ex_nop | $builddir/nop.asm $builddir/nop.idma.dat
build test:         test_usage

default $builddir/ex_nop $builddir/nop.asm $builddir/nop.idma.dat
