# build.ninja — 40-mv-13
include ../../scripts/sdk.ninja
include ../../scripts/examples.ninja

# カーネル
build $builddir/mv-p13.asm: asm3_text data/mv-p13.vsm
build $builddir/mv-p13.idma.dat: asm3_loader data/mv-p13.vsm
  stem = $builddir/mv-p13

# test driver
build $builddir/ex_mv_13.o: cc ex_mv_13.c
build $builddir/ex_mv_13: link $builddir/ex_mv_13.o | ${sdk_root}/lib/libmnc2.a

# test targets
build test-emu:     test_emu_process $builddir/ex_mv_13 | $builddir/mv-p13.asm $builddir/mv-p13.idma.dat
build test-emu-lib: test_emu_lib     $builddir/ex_mv_13 | $builddir/mv-p13.asm $builddir/mv-p13.idma.dat
build test-device:  test_device      $builddir/ex_mv_13 | $builddir/mv-p13.asm $builddir/mv-p13.idma.dat
build test:         test_usage

default $builddir/ex_mv_13 $builddir/mv-p13.asm $builddir/mv-p13.idma.dat
