# build.ninja — 26-t8-right-neighbor
include ../../scripts/sdk.ninja
include ../../scripts/examples.ninja

# カーネル
build $builddir/t8_right_neighbor.asm: asm3_text data/t8_right_neighbor.vsm
build $builddir/t8_right_neighbor.idma.dat: asm3_loader data/t8_right_neighbor.vsm
  stem = $builddir/t8_right_neighbor

# test driver
build $builddir/ex_t8_right_neighbor.o: cc ex_t8_right_neighbor.c
build $builddir/ex_t8_right_neighbor: link $builddir/ex_t8_right_neighbor.o | ${sdk_root}/lib/libmnc2.a

# test targets
build test-emu:     test_emu_process $builddir/ex_t8_right_neighbor | $builddir/t8_right_neighbor.asm $builddir/t8_right_neighbor.idma.dat
build test-emu-lib: test_emu_lib     $builddir/ex_t8_right_neighbor | $builddir/t8_right_neighbor.asm $builddir/t8_right_neighbor.idma.dat
build test-device:  test_device      $builddir/ex_t8_right_neighbor | $builddir/t8_right_neighbor.asm $builddir/t8_right_neighbor.idma.dat
build test:         test_usage

default $builddir/ex_t8_right_neighbor $builddir/t8_right_neighbor.asm $builddir/t8_right_neighbor.idma.dat
