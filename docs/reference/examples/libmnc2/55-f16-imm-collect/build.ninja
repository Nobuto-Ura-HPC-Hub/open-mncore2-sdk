# build.ninja — 55-f16-imm-collect
include ../../scripts/sdk.ninja
include ../../scripts/examples.ninja

# カーネル
build $builddir/f16_imm_collect.asm: asm3_text data/f16_imm_collect.vsm
build $builddir/f16_imm_collect.idma.dat: asm3_loader data/f16_imm_collect.vsm
  stem = $builddir/f16_imm_collect

# test driver
build $builddir/ex_f16_imm_collect.o: cc ex_f16_imm_collect.c
build $builddir/ex_f16_imm_collect: link $builddir/ex_f16_imm_collect.o | ${sdk_root}/lib/libmnc2.a

# test targets
build test-emu:     test_emu_process $builddir/ex_f16_imm_collect | $builddir/f16_imm_collect.asm $builddir/f16_imm_collect.idma.dat
build test-emu-lib: test_emu_lib     $builddir/ex_f16_imm_collect | $builddir/f16_imm_collect.asm $builddir/f16_imm_collect.idma.dat
build test-device:  test_device      $builddir/ex_f16_imm_collect | $builddir/f16_imm_collect.asm $builddir/f16_imm_collect.idma.dat
build test:         test_usage

default $builddir/ex_f16_imm_collect $builddir/f16_imm_collect.asm $builddir/f16_imm_collect.idma.dat
