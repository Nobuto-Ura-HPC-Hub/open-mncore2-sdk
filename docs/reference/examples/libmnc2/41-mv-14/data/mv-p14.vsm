# mv-p14.vsm — Pattern 14: L2BM → DRAM グループ内縮約 (3.5.8.14, mvr2dfadd)
#
# 動作:
#   Setup:    PDM@G0[0..63] → DRAM@G0[0..63] (#6)
#             DRAM@G0 → 全グループ L2BM (mvb2 broadcast, #11)
#   Test:     L2BM@グループ内 → DRAM@G0 加算縮約 (mvr2dfadd, 3.5.8.14) ← 検証対象
#             ※ グループ内 2 L2B の和 → DRAM@G0 (2x 入力)
#   Gather:   DRAM@G0 → PDM@G0 (#8) ← recv trigger
# 結果: PDM@G0[i] = 2 * (i+1) (G0 内 2 L2B の加算縮約)
# DMA: send_wait_tag=2, recv_wait_tag=6

	nop; wait i02
	nop/3
	# Setup step1: PDM@G0[0..63] → DRAM@G0[0..63] (#6)
	mvp/n64i01 $p0@0 $d0@0
	nop/2
	nop; wait i01
	nop/5
	# Setup step2: DRAM@G0 → G0 内全 L2BM (mvb2, #11)
	mvb2/n64i04 $d0 $lc0
	nop/2
	nop; wait i04
	nop/5
	# Test: L2BM@G0 グループ内縮約 → DRAM@G0 (mvr2dfadd, 3.5.8.14)
	mvr2dfadd/n64i03 $lc0 $d0
	nop/2
	nop; wait i03
	nop/5
	# Gather: DRAM@G0 → PDM@G0 (#8) → recv trigger
	mvp/n64i06 $d0@0 $p0@0
	nop/2
	nop; wait i06
	nop/5
	# pseudo ret
