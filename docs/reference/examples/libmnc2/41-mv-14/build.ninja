# build.ninja — 41-mv-14
include ../../scripts/sdk.ninja
include ../../scripts/examples.ninja

# カーネル
build $builddir/mv-p14.asm: asm3_text data/mv-p14.vsm
build $builddir/mv-p14.idma.dat: asm3_loader data/mv-p14.vsm
  stem = $builddir/mv-p14

# test driver
build $builddir/ex_mv_14.o: cc ex_mv_14.c
build $builddir/ex_mv_14: link $builddir/ex_mv_14.o | ${sdk_root}/lib/libmnc2.a

# test targets
build test-emu:     test_emu_process $builddir/ex_mv_14 | $builddir/mv-p14.asm $builddir/mv-p14.idma.dat
build test-emu-lib: test_emu_lib     $builddir/ex_mv_14 | $builddir/mv-p14.asm $builddir/mv-p14.idma.dat
build test-device:  test_device      $builddir/ex_mv_14 | $builddir/mv-p14.asm $builddir/mv-p14.idma.dat
build test:         test_usage

default $builddir/ex_mv_14 $builddir/mv-p14.asm $builddir/mv-p14.idma.dat
