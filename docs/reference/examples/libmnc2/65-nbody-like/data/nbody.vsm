	dvfmad $lr8 $ls6 $mauf $lr8
	nop/4
	dvadd $lr8 $ls4 $ls4
	nop/4
	# === 粒子 20, 21: l1bmp 1 命令で (x_20, m_20, x_21, m_21) を引き出す ===
	l1bmp $lb296 $lr0v
	nop/24
	# -- 粒子 20: F_j += (x_i - x_j) * (m_i * m_j) --
