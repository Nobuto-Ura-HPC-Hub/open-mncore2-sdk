	lpassa $ls4 $lm0
	nop/24
	# 占有 L1BM [512, 768)。 結合方向にはマスクが効かないため、
	# 4 cycle 分 256 u64 すべてが上書きされる。
	# 回収するのは cycle 0 の [512, 576) のみ。
	l1bmd $lm0v $lb512
	nop/24
	nop/24
	l2bm@0 $lb512 $lc2048
	l2bm@1 $lb512 $lc2112
	l2bm@2 $lb512 $lc2176
	l2bm@3 $lb512 $lc2240
	l2bm@4 $lb512 $lc2304
	l2bm@5 $lb512 $lc2368
	l2bm@6 $lb512 $lc2432
	l2bm@7 $lb512 $lc2496
	nop/5
	mvp/n512 $lc2048@0.0 $p0@0
	mvp/n512i19 $lc2048@0.1 $p512@0
	nop/3
	nop; wait i19
	mvp/n512 $lc2048@1.0 $p1024@0
	mvp/n512i1a $lc2048@1.1 $p1536@0
	nop/3
	nop; wait i1a
	mvp/n512 $lc2048@2.0 $p2048@0
	mvp/n512i1c $lc2048@2.1 $p2560@0
	nop/3
	nop; wait i1c
	mvp/n512 $lc2048@3.0 $p3072@0
	mvp/n512i1e $lc2048@3.1 $p3584@0
	nop/3
	nop; wait i1e
	nop/4
	# pseudo ret
