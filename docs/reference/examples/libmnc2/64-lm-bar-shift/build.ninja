# build.ninja — 64-lm-bar-shift
include ../../scripts/sdk.ninja
include ../../scripts/examples.ninja

# カーネル
build $builddir/barshift.asm:      asm3_text   data/barshift.vsm
build $builddir/barshift.idma.dat: asm3_loader data/barshift.vsm
  stem = $builddir/barshift

# test driver
build $builddir/ex_barshift.o: cc ex_barshift.c
build $builddir/ex_barshift:   link $builddir/ex_barshift.o | ${sdk_root}/lib/libmnc2.a

# test targets (全 backend 対応)
build test:         test_usage
build test-emu:     test_emu_process $builddir/ex_barshift | $builddir/barshift.asm $builddir/barshift.idma.dat
build test-emu-lib: test_emu_lib     $builddir/ex_barshift | $builddir/barshift.asm $builddir/barshift.idma.dat
build test-device:  test_device      $builddir/ex_barshift | $builddir/barshift.asm $builddir/barshift.idma.dat

default $builddir/ex_barshift $builddir/barshift.asm $builddir/barshift.idma.dat
