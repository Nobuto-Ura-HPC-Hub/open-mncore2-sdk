# f64-imm-collect: f64 1.5 を imm (整数即値) で GRF に設定 → collect で PDM に書き出す
#
# f64 1.5 = 0x3FF80000_00000000
#   $r0 が $lr0 の上位 32bit
#   imm i"1073217536" $r0  → 0x3FF80000 (上位)
#   imm i"0" $r1           → 0x00000000 (下位)
#
# DMA 送信なし。PE 内部で即値生成 → collect パスのみ。
# collect 先: PDM word 0
# recv_wait_tag: 0x1e (最終 mvp done flag)

	imm i"1073217536" $r0
	imm i"0" $r1
	nop/4
# GRF0 → LM0
	lpassa $lr0 $lm0
	nop/24
# LM0 → L1BM
	# 占有 L1BM [256, 512)。結合方向にはマスクが効かないため、
	# 4 cycle 分 256 u64 すべてが上書きされる。
	# 回収するのは cycle 0 の [256, 320) のみ。
	l1bmd $lm0v $lb256
	nop/24
	nop/24
# L1BM → L2BM
	l2bm@0 $lb256 $lc1024
	l2bm@1 $lb256 $lc1088
	l2bm@2 $lb256 $lc1152
	l2bm@3 $lb256 $lc1216
	l2bm@4 $lb256 $lc1280
	l2bm@5 $lb256 $lc1344
	l2bm@6 $lb256 $lc1408
	l2bm@7 $lb256 $lc1472
	nop/5
# L2BM → PDM (4 グループ × 512 u64)
	mvp/n512 $lc1024@0.0 $p0@0
	mvp/n512i19 $lc1024@0.1 $p512@0
	nop/3
	nop; wait i19
	mvp/n512 $lc1024@1.0 $p1024@0
	mvp/n512i1a $lc1024@1.1 $p1536@0
	nop/3
	nop; wait i1a
	mvp/n512 $lc1024@2.0 $p2048@0
	mvp/n512i1c $lc1024@2.1 $p2560@0
	nop/3
	nop; wait i1c
	mvp/n512 $lc1024@3.0 $p3072@0
	mvp/n512i1e $lc1024@3.1 $p3584@0
	nop/3
	nop; wait i1e
	nop/4
	# pseudo ret
