# build.ninja — 35-mv-5b
include ../../scripts/sdk.ninja
include ../../scripts/examples.ninja

# カーネル
build $builddir/mv-p5b.asm: asm3_text data/mv-p5b.vsm
build $builddir/mv-p5b.idma.dat: asm3_loader data/mv-p5b.vsm
  stem = $builddir/mv-p5b

# test driver
build $builddir/ex_mv_5b.o: cc ex_mv_5b.c
build $builddir/ex_mv_5b: link $builddir/ex_mv_5b.o | ${sdk_root}/lib/libmnc2.a

# test targets
build test-emu:     test_emu_process $builddir/ex_mv_5b | $builddir/mv-p5b.asm $builddir/mv-p5b.idma.dat
build test-emu-lib: test_emu_lib     $builddir/ex_mv_5b | $builddir/mv-p5b.asm $builddir/mv-p5b.idma.dat
build test-device:  test_device      $builddir/ex_mv_5b | $builddir/mv-p5b.asm $builddir/mv-p5b.idma.dat
build test:         test_usage

default $builddir/ex_mv_5b $builddir/mv-p5b.asm $builddir/mv-p5b.idma.dat
