# build.ninja — 66-broadcast-l1bmp
include ../../scripts/sdk.ninja
include ../../scripts/examples.ninja

# カーネル
build $builddir/broadcast_l1bmp.asm:      asm3_text   data/broadcast_l1bmp.vsm
build $builddir/broadcast_l1bmp.idma.dat: asm3_loader data/broadcast_l1bmp.vsm
  stem = $builddir/broadcast_l1bmp

# test driver
build $builddir/ex_broadcast_l1bmp.o: cc ex_broadcast_l1bmp.c
build $builddir/ex_broadcast_l1bmp:   link $builddir/ex_broadcast_l1bmp.o | ${sdk_root}/lib/libmnc2.a

# test targets (全 backend 対応)
build test:         test_usage
build test-emu:     test_emu_process $builddir/ex_broadcast_l1bmp | $builddir/broadcast_l1bmp.asm $builddir/broadcast_l1bmp.idma.dat
build test-emu-lib: test_emu_lib     $builddir/ex_broadcast_l1bmp | $builddir/broadcast_l1bmp.asm $builddir/broadcast_l1bmp.idma.dat
build test-device:  test_device      $builddir/ex_broadcast_l1bmp | $builddir/broadcast_l1bmp.asm $builddir/broadcast_l1bmp.idma.dat

default $builddir/ex_broadcast_l1bmp $builddir/broadcast_l1bmp.asm $builddir/broadcast_l1bmp.idma.dat
