# build.ninja — 49-reduce-pe-vec
include ../../scripts/sdk.ninja
include ../../scripts/examples.ninja

# カーネル
build $builddir/reduce-pe-s3v.asm: asm3_text data/reduce-pe-s3v.vsm
build $builddir/reduce-pe-s3v.idma.dat: asm3_loader data/reduce-pe-s3v.vsm
  stem = $builddir/reduce-pe-s3v

# test driver
build $builddir/ex_reduce_pe_vec.o: cc ex_reduce_pe_vec.c
build $builddir/ex_reduce_pe_vec: link $builddir/ex_reduce_pe_vec.o | ${sdk_root}/lib/libmnc2.a

# test targets
build test-emu:     test_emu_process $builddir/ex_reduce_pe_vec | $builddir/reduce-pe-s3v.asm $builddir/reduce-pe-s3v.idma.dat
build test-emu-lib: test_emu_lib     $builddir/ex_reduce_pe_vec | $builddir/reduce-pe-s3v.asm $builddir/reduce-pe-s3v.idma.dat
build test-device:  test_device      $builddir/ex_reduce_pe_vec | $builddir/reduce-pe-s3v.asm $builddir/reduce-pe-s3v.idma.dat
build test:         test_usage

default $builddir/ex_reduce_pe_vec $builddir/reduce-pe-s3v.asm $builddir/reduce-pe-s3v.idma.dat
