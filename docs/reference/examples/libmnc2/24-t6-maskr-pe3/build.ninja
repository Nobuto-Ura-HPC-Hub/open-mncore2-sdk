# build.ninja — 24-t6-maskr-pe3
include ../../scripts/sdk.ninja
include ../../scripts/examples.ninja

# カーネル
build $builddir/t6_maskr_pe3.asm: asm3_text data/t6_maskr_pe3.vsm
build $builddir/t6_maskr_pe3.idma.dat: asm3_loader data/t6_maskr_pe3.vsm
  stem = $builddir/t6_maskr_pe3

# test driver
build $builddir/ex_t6_maskr_pe3.o: cc ex_t6_maskr_pe3.c
build $builddir/ex_t6_maskr_pe3: link $builddir/ex_t6_maskr_pe3.o | ${sdk_root}/lib/libmnc2.a

# test targets
build test-emu:     test_emu_process $builddir/ex_t6_maskr_pe3 | $builddir/t6_maskr_pe3.asm $builddir/t6_maskr_pe3.idma.dat
build test-emu-lib: test_emu_lib     $builddir/ex_t6_maskr_pe3 | $builddir/t6_maskr_pe3.asm $builddir/t6_maskr_pe3.idma.dat
build test-device:  test_device      $builddir/ex_t6_maskr_pe3 | $builddir/t6_maskr_pe3.asm $builddir/t6_maskr_pe3.idma.dat
build test:         test_usage

default $builddir/ex_t6_maskr_pe3 $builddir/t6_maskr_pe3.asm $builddir/t6_maskr_pe3.idma.dat
