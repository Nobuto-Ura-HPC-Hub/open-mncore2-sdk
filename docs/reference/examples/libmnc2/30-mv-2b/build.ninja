# build.ninja — 30-mv-2b
include ../../scripts/sdk.ninja
include ../../scripts/examples.ninja

# カーネル
build $builddir/mv-p2b.asm: asm3_text data/mv-p2b.vsm
build $builddir/mv-p2b.idma.dat: asm3_loader data/mv-p2b.vsm
  stem = $builddir/mv-p2b

# test driver
build $builddir/ex_mv_2b.o: cc ex_mv_2b.c
build $builddir/ex_mv_2b: link $builddir/ex_mv_2b.o | ${sdk_root}/lib/libmnc2.a

# test targets
build test-emu:     test_emu_process $builddir/ex_mv_2b | $builddir/mv-p2b.asm $builddir/mv-p2b.idma.dat
build test-emu-lib: test_emu_lib     $builddir/ex_mv_2b | $builddir/mv-p2b.asm $builddir/mv-p2b.idma.dat
build test-device:  test_device      $builddir/ex_mv_2b | $builddir/mv-p2b.asm $builddir/mv-p2b.idma.dat
build test:         test_usage

default $builddir/ex_mv_2b $builddir/mv-p2b.asm $builddir/mv-p2b.idma.dat
