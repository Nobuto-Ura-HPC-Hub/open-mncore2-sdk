# collect-dram.vsm — 56 Kernel C1: PE → DRAM (PE ID 上位 32bit 埋め込み)
#
# 前提: 直前の add1 が終了した時点で、各 PE の $lr0 にデータ
# (= (i << 16) + N) が残っている。$lr0 の HIGH 32bit (= $r0) は 0、
# LOW 32bit (= $r1) に有効データ。
#
# このカーネルは:
#   1. flat PE ID = $peid | ($l1bid << 6) | ($l2bid << 9) を $lr16 LOW で合成
#   2. ipassa で $lr16 LOW (= $r17) を $lr0 HIGH (= $r0) に書き込み、
#      $lr0 = (high: id, low: data) になる
#   3. $lr0 → LM → L1BM → L2BM → DRAM (= add1.vsm Phase 5/6/7 と同形)
#
# DRAM で停止。続けて collect-dram-pdm0.vsm で PDM へ。

# ===== Phase 1: PE compute (PE ID 合成 + $r0 マージ) =====

# Step 1: $peid → $lr32 (no shift)
	lpassa $peid $lr32
	nop/4

# Step 2: $l1bid << 6 → $lr40 (shift 量は $lr16 経由で供給)
	imm i"6" $r17
	imm i"0" $r16
	nop/4
	lpassa $lr16 $ln0
	nop/24
	lpassa $l1bid $lr40
	nop/4
	ilsl $lr40 $ln0 $lr40
	nop/4

# Step 3: $l2bid << 9 → $lr48
	imm i"9" $r17
	nop/4
	lpassa $lr16 $ln0
	nop/24
	lpassa $l2bid $lr48
	nop/4
	ilsl $lr48 $ln0 $lr48
	nop/4

# Step 4: 合成 → $lr16 (= flat PE ID in lower 32bit)
	lpassa $lr32 $lr16
	nop/4
	lpassa $lr40 $ln0
	nop/24
	iadd $ln0 $lr16 $lr16
	nop/4
	lpassa $lr48 $ln0
	nop/24
	iadd $ln0 $lr16 $lr16
	nop/4

# Step 5: $r17 (= $lr16 LOW = ID) → $r0 (= $lr0 HIGH)
#   ipassa は 32bit short → short の move、$r1 (LOW = data) は不変
	ipassa $r17 $r0
	nop/4

# ===== Phase 2: LM → L1BM =====
	lpassa $lr0 $lm0v
	nop/4
	# 占有 L1BM [256, 512)。結合方向にはマスクが効かないため、
	# 4 cycle 分 256 u64 すべてが上書きされる。
	# 回収するのは cycle 0 の [256, 320) のみ。
	l1bmd $lm0v $lb256
	nop/24

# ===== Phase 3: L1BM → L2BM (8x l2bm) =====
	l2bm@0 $lb256 $lc0
	l2bm@1 $lb256 $lc64
	l2bm@2 $lb256 $lc128
	l2bm@3 $lb256 $lc192
	l2bm@4 $lb256 $lc256
	l2bm@5 $lb256 $lc320
	l2bm@6 $lb256 $lc384
	l2bm@7 $lb256 $lc448
	nop/5

# ===== Phase 4: L2BM → DRAM 並列個別 =====
	mvp/n512    $lc0@.0 $d0
	mvp/n512i01 $lc0@.1 $d512
	nop/2
	nop; wait i01
	nop/5
	# pseudo ret
