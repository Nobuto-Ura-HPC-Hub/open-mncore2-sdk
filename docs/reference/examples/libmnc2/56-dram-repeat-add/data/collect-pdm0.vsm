# collect-pdm0.vsm — 56 Kernel C': PE → PDM@0 直結 (DRAM 経由なし)
#
# 前提: 直前の add1 が終了した時点で各 PE の $lr0 にデータが残っている
# (collect-dram.vsm と同じ前提)。
#
# 動作:
#   1. PE compute で flat PE ID を $r0 (= $lr0 HIGH 32bit) に書く
#      (= collect-dram.vsm Phase 1 と同じ)
#   2. LM → L1BM → L2BM (= add1 Phase 5/6 と同じ)
#   3. L2BM → PDM@0 を 8x mvp 単独個別で集約。出力 PDM offset を 4096 LW
#      シフトすることで、PDM@0[0..4095] (= 入力データ) を上書きせず、
#      PDM@0[4096..8191] (= 32768〜65535 byte) に出力を置く
#
# host 側は mnc2_recv の pdm_offset を 32768 byte (= BLOCK_BYTES) にすれば
# この出力を読める。in / out の両方が PDM 上に同時に残る。

# ===== Phase 1: PE compute (PE ID 合成 + $r0 マージ) =====

# Step 1: $peid → $lr32
	lpassa $peid $lr32
	nop/4

# Step 2: $l1bid << 6 → $lr40
	imm i"6" $r17
	imm i"0" $r16
	nop/4
	lpassa $lr16 $ln0
	nop/24
	lpassa $l1bid $lr40
	nop/4
	ilsl $lr40 $ln0 $lr40
	nop/4

# Step 3: $l2bid << 9 → $lr48
	imm i"9" $r17
	nop/4
	lpassa $lr16 $ln0
	nop/24
	lpassa $l2bid $lr48
	nop/4
	ilsl $lr48 $ln0 $lr48
	nop/4

# Step 4: 合成 → $lr16
	lpassa $lr32 $lr16
	nop/4
	lpassa $lr40 $ln0
	nop/24
	iadd $ln0 $lr16 $lr16
	nop/4
	lpassa $lr48 $ln0
	nop/24
	iadd $ln0 $lr16 $lr16
	nop/4

# Step 5: $r17 → $r0 ($lr0 HIGH に id を merge)
	ipassa $r17 $r0
	nop/4

# ===== Phase 2: LM → L1BM =====
	lpassa $lr0 $lm0v
	nop/4
	# 占有 L1BM [256, 512)。結合方向にはマスクが効かないため、
	# 4 cycle 分 256 u64 すべてが上書きされる。
	# 回収するのは cycle 0 の [256, 320) のみ。
	l1bmd $lm0v $lb256
	nop/24

# ===== Phase 3: L1BM → L2BM (8x l2bm) =====
	l2bm@0 $lb256 $lc0
	l2bm@1 $lb256 $lc64
	l2bm@2 $lb256 $lc128
	l2bm@3 $lb256 $lc192
	l2bm@4 $lb256 $lc256
	l2bm@5 $lb256 $lc320
	l2bm@6 $lb256 $lc384
	l2bm@7 $lb256 $lc448
	nop/5

# ===== Phase 4: L2BM → PDM@0 (offset 4096 LW、8x mvp/n512 単独個別) =====
#   8 個の (group, bank) → PDM@0 の異なる offset
#     G0.0 → PDM@0[4096..4607]
#     G0.1 → PDM@0[4608..5119]
#     G1.0 → PDM@0[5120..5631]
#     G1.1 → PDM@0[5632..6143]
#     G2.0 → PDM@0[6144..6655]
#     G2.1 → PDM@0[6656..7167]
#     G3.0 → PDM@0[7168..7679]
#     G3.1 → PDM@0[7680..8191]
	mvp/n512    $lc0@0.0 $p4096@0
	mvp/n512    $lc0@0.1 $p4608@0
	mvp/n512    $lc0@1.0 $p5120@0
	mvp/n512    $lc0@1.1 $p5632@0
	mvp/n512    $lc0@2.0 $p6144@0
	mvp/n512    $lc0@2.1 $p6656@0
	mvp/n512    $lc0@3.0 $p7168@0
	mvp/n512i06 $lc0@3.1 $p7680@0
	nop/2
	nop; wait i06
	nop/5
	# pseudo ret
