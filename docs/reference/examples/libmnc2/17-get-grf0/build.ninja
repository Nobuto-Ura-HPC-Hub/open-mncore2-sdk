# build.ninja — 17-get-grf0
# put+get ペアは kernel 間の memory 保持が必要なため emu:lib / device でのみ効果があり、
# emu:process では test 内で SKIP される。

include ../../scripts/sdk.ninja
include ../../scripts/examples.ninja

build $builddir/put_grf.asm: asm3_text data/put_grf.vsm
build $builddir/put_grf.idma.dat: asm3_loader data/put_grf.vsm
  stem = $builddir/put_grf
build $builddir/get_grf.asm: asm3_text data/get_grf.vsm
build $builddir/get_grf.idma.dat: asm3_loader data/get_grf.vsm
  stem = $builddir/get_grf

build $builddir/ex_get_grf0.o: cc ex_get_grf0.c
build $builddir/ex_get_grf0: link $builddir/ex_get_grf0.o | ${sdk_root}/lib/libmnc2.a

build test:         test_usage_no_emu
build test-emu-lib: test_emu_lib     $builddir/ex_get_grf0 | $builddir/put_grf.asm $builddir/put_grf.idma.dat $builddir/get_grf.asm $builddir/get_grf.idma.dat
build test-device:  test_device      $builddir/ex_get_grf0 | $builddir/put_grf.asm $builddir/put_grf.idma.dat $builddir/get_grf.asm $builddir/get_grf.idma.dat

default $builddir/ex_get_grf0 $builddir/put_grf.idma.dat $builddir/get_grf.idma.dat
