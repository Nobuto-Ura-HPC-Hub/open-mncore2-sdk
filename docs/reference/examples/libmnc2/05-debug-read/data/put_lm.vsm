# put_lm: PDM -> L2BM -> L1BM -> LM0 (mvp + l2bmb + l1bmd)
#
# debug_read(MNC2_MEM_LM0) のテスト用。
# roundtrip.vsm の前半 (distribute パス) と同等。
# LM0 に残ったデータを debug_read で読み出して検証する。

	nop; wait i10
	nop/3
	mvp/n512 $p0@0 $lc0@0.0
	mvp/n512 $p512@0 $lc0@0.1
	mvp/n512 $p1024@0 $lc0@1.0
	mvp/n512 $p1536@0 $lc0@1.1
	mvp/n512 $p2048@0 $lc0@2.0
	mvp/n512 $p2560@0 $lc0@2.1
	mvp/n512 $p3072@0 $lc0@3.0
	mvp/n512i23 $p3584@0 $lc0@3.1
	nop/2
	nop; wait i23
	nop/5
	l2bmb@0 $lc0 $lb0
	l2bmb@1 $lc64 $lb0
	l2bmb@2 $lc128 $lb0
	l2bmb@3 $lc192 $lb0
	l2bmb@4 $lc256 $lb0
	l2bmb@5 $lc320 $lb0
	l2bmb@6 $lc384 $lb0
	l2bmb@7 $lc448 $lb0
	nop/5
	# 占有 L1BM [0, 256)。有効データは直前の l2bmb が埋めた
	# cycle 0 の [0, 64) のみ。/1000 で cycle 1..3 の PE 側書き込みを
	# 止める (L1BM 側の 256 u64 読み出しはマスクでは減らない)。
	l1bmd $lb0 $lm0v/1000
	nop/24
	nop/24
	nop/4
	# pseudo ret
