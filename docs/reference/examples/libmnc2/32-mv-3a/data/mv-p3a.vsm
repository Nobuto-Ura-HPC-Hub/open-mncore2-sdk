# mv-p3a.vsm — Pattern 3A: PDM@0~3 → DRAM@0~3 via 4x individual mvp (3.5.8.2)
#
# 動作:
#   Setup:    PDM@0[G*64..G*64+63] → PDM@G[0..63] for G=1,2,3 (各グループに異なるデータ配布)
#   Pattern3: PDM@G[0..63] → DRAM@G[0..63] for G=0,1,2,3 (各グループ自身の PDM→DRAM)
#   Gather:   DRAM@G[0..63] → PDM@0[G*64..G*64+63] (ホスト検証用)
# 入力: PDM@0[0..255] = 4 ブロック (各グループのデータ)
# 結果: PDM@0[0..255] = roundtrip (元のデータ復元)
# DMA: send_wait_tag=2, recv_wait_tag=6

	nop; wait i02
	nop/3
	# Setup: distribute 4 blocks from PDM@0 to each group's PDM
	mvp/n64 $p64@0 $p0@1
	mvp/n64 $p128@0 $p0@2
	mvp/n64i01 $p192@0 $p0@3
	nop/2
	nop; wait i01
	nop/5
	# Pattern 3: PDM@G[0..63] → DRAM@G[0..63] (4x individual, each group's own transfer)
	mvp/n64 $p0@0 $d0@0
	mvp/n64 $p0@1 $d0@1
	mvp/n64 $p0@2 $d0@2
	mvp/n64i03 $p0@3 $d0@3
	nop/2
	nop; wait i03
	nop/5
	# Gather back: DRAM@G[0..63] → PDM@0[G*64..G*64+63]
	mvp/n64 $d0@0 $p0@0
	mvp/n64 $d0@1 $p64@0
	mvp/n64 $d0@2 $p128@0
	mvp/n64i06 $d0@3 $p192@0
	nop/2
	nop; wait i06
	nop/5
	# pseudo ret
