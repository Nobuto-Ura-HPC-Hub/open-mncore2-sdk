# build.ninja — 32-mv-3a
include ../../scripts/sdk.ninja
include ../../scripts/examples.ninja

# カーネル
build $builddir/mv-p3a.asm: asm3_text data/mv-p3a.vsm
build $builddir/mv-p3a.idma.dat: asm3_loader data/mv-p3a.vsm
  stem = $builddir/mv-p3a

# test driver
build $builddir/ex_mv_3a.o: cc ex_mv_3a.c
build $builddir/ex_mv_3a: link $builddir/ex_mv_3a.o | ${sdk_root}/lib/libmnc2.a

# test targets
build test-emu:     test_emu_process $builddir/ex_mv_3a | $builddir/mv-p3a.asm $builddir/mv-p3a.idma.dat
build test-emu-lib: test_emu_lib     $builddir/ex_mv_3a | $builddir/mv-p3a.asm $builddir/mv-p3a.idma.dat
build test-device:  test_device      $builddir/ex_mv_3a | $builddir/mv-p3a.asm $builddir/mv-p3a.idma.dat
build test:         test_usage

default $builddir/ex_mv_3a $builddir/mv-p3a.asm $builddir/mv-p3a.idma.dat
