# build.ninja — 34-mv-5a
include ../../scripts/sdk.ninja
include ../../scripts/examples.ninja

# カーネル
build $builddir/mv-p5a.asm: asm3_text data/mv-p5a.vsm
build $builddir/mv-p5a.idma.dat: asm3_loader data/mv-p5a.vsm
  stem = $builddir/mv-p5a

# test driver
build $builddir/ex_mv_5a.o: cc ex_mv_5a.c
build $builddir/ex_mv_5a: link $builddir/ex_mv_5a.o | ${sdk_root}/lib/libmnc2.a

# test targets
build test-emu:     test_emu_process $builddir/ex_mv_5a | $builddir/mv-p5a.asm $builddir/mv-p5a.idma.dat
build test-emu-lib: test_emu_lib     $builddir/ex_mv_5a | $builddir/mv-p5a.asm $builddir/mv-p5a.idma.dat
build test-device:  test_device      $builddir/ex_mv_5a | $builddir/mv-p5a.asm $builddir/mv-p5a.idma.dat
build test:         test_usage

default $builddir/ex_mv_5a $builddir/mv-p5a.asm $builddir/mv-p5a.idma.dat
