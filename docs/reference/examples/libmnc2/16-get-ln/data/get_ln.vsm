# get_ln: LM1 -> L1BM -> L2BM -> PDM (collect: l1bmd + l2bm + mvp)
#
# put_ln 実行後に使用。LM1 の内容を L1BM → L2BM 経由で PDM word 131072 に書き戻す。
#
# recv: recv_wait_tag=0x1e (最終 mvp done flag)

	# 占有 L1BM [256, 512)。結合方向にはマスクが効かないため、
	# 4 cycle 分 256 u64 すべてが上書きされる。
	# 回収するのは cycle 0 の [256, 320) のみ。
	l1bmd $ln0v $lb256
	nop/24
	nop/24
	l2bm@0 $lb256 $lc1024
	l2bm@1 $lb256 $lc1088
	l2bm@2 $lb256 $lc1152
	l2bm@3 $lb256 $lc1216
	l2bm@4 $lb256 $lc1280
	l2bm@5 $lb256 $lc1344
	l2bm@6 $lb256 $lc1408
	l2bm@7 $lb256 $lc1472
	nop/5
	mvp/n512 $lc1024@0.0 $p131072@0
	mvp/n512i19 $lc1024@0.1 $p131584@0
	nop/3
	nop; wait i19
	mvp/n512 $lc1024@1.0 $p132096@0
	mvp/n512i1a $lc1024@1.1 $p132608@0
	nop/3
	nop; wait i1a
	mvp/n512 $lc1024@2.0 $p133120@0
	mvp/n512i1c $lc1024@2.1 $p133632@0
	nop/3
	nop; wait i1c
	mvp/n512 $lc1024@3.0 $p134144@0
	mvp/n512i1e $lc1024@3.1 $p134656@0
	nop/3
	nop; wait i1e
	nop/4
	# pseudo ret
