# build.ninja — 16-get-ln
# put+get ペアは kernel 間の memory 保持が必要なため emu:lib / device でのみ効果があり、
# emu:process では test 内で SKIP される。

include ../../scripts/sdk.ninja
include ../../scripts/examples.ninja

build $builddir/put_ln.asm: asm3_text data/put_ln.vsm
build $builddir/put_ln.idma.dat: asm3_loader data/put_ln.vsm
  stem = $builddir/put_ln
build $builddir/get_ln.asm: asm3_text data/get_ln.vsm
build $builddir/get_ln.idma.dat: asm3_loader data/get_ln.vsm
  stem = $builddir/get_ln

build $builddir/ex_get_ln.o: cc ex_get_ln.c
build $builddir/ex_get_ln: link $builddir/ex_get_ln.o | ${sdk_root}/lib/libmnc2.a

build test:         test_usage_no_emu
build test-emu-lib: test_emu_lib     $builddir/ex_get_ln | $builddir/put_ln.asm $builddir/put_ln.idma.dat $builddir/get_ln.asm $builddir/get_ln.idma.dat
build test-device:  test_device      $builddir/ex_get_ln | $builddir/put_ln.asm $builddir/put_ln.idma.dat $builddir/get_ln.asm $builddir/get_ln.idma.dat

default $builddir/ex_get_ln $builddir/put_ln.idma.dat $builddir/get_ln.idma.dat
