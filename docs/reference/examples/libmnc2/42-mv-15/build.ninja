# build.ninja — 42-mv-15
include ../../scripts/sdk.ninja
include ../../scripts/examples.ninja

# カーネル
build $builddir/mv-p15.asm: asm3_text data/mv-p15.vsm
build $builddir/mv-p15.idma.dat: asm3_loader data/mv-p15.vsm
  stem = $builddir/mv-p15

# test driver
build $builddir/ex_mv_15.o: cc ex_mv_15.c
build $builddir/ex_mv_15: link $builddir/ex_mv_15.o | ${sdk_root}/lib/libmnc2.a

# test targets
build test-emu:     test_emu_process $builddir/ex_mv_15 | $builddir/mv-p15.asm $builddir/mv-p15.idma.dat
build test-emu-lib: test_emu_lib     $builddir/ex_mv_15 | $builddir/mv-p15.asm $builddir/mv-p15.idma.dat
build test-device:  test_device      $builddir/ex_mv_15 | $builddir/mv-p15.asm $builddir/mv-p15.idma.dat
build test:         test_usage

default $builddir/ex_mv_15 $builddir/mv-p15.asm $builddir/mv-p15.idma.dat
