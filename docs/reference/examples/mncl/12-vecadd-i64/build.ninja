# 12-vecadd-i64: c[i] = a[i] + b[i] (4096 PE, i64 整数加算 ladd)
#
# ninja              -> .cl -> ._vsm -> .vsm
# ninja build-e2e    -> + vsmlink + assemble3 + host C
# ninja test         -> usage 表示
# ninja test-emu-lib -> emu:lib backend で実行・検証
# ninja test-device  -> 実機 backend で実行・検証

include ../scripts/mncl.ninja
include ../../scripts/sdk.ninja
builddir = _build

# --- kernel ---
build $builddir/vecadd-i64._vsm: emit-vsm vecadd-i64.cl

build $builddir/vecadd-i64.vsm: vsmlink $builddir/vecadd-i64._vsm vecadd-i64.param vecadd-i64.stparam
  vsm = $builddir/vecadd-i64._vsm
  param = vecadd-i64.param
  stparam = vecadd-i64.stparam

build $builddir/vecadd-i64.asm: asm3 $builddir/vecadd-i64.vsm
build $builddir/vecadd-i64.idma.dat: asm3_loader $builddir/vecadd-i64.vsm
  stem = $builddir/vecadd-i64

# --- host driver ---
build $builddir/test_vecadd-i64.o: cc test_vecadd-i64.c
build $builddir/test_vecadd-i64: link $builddir/test_vecadd-i64.o

# --- ビルド段階 phony ---
build build-e2e: phony $builddir/vecadd-i64.asm $builddir/vecadd-i64.idma.dat $builddir/test_vecadd-i64

# --- test 3 種 ---
build test-emu-lib: test_emu_lib $builddir/test_vecadd-i64 | $builddir/vecadd-i64.asm $builddir/vecadd-i64.idma.dat
build test-device:  test_device  $builddir/test_vecadd-i64 | $builddir/vecadd-i64.asm $builddir/vecadd-i64.idma.dat
build test:         test_usage

build clean: clean

default $builddir/vecadd-i64.asm $builddir/vecadd-i64.idma.dat
