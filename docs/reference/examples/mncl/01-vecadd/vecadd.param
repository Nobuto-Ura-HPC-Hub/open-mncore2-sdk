;; send_wait_tag はホストがタグ #x10 で送る slot 8（a）にだけ付ける。b（slot 16）はタグ 0 で
;; exec の前に送り終えているので待たない（vsmlink 0.10.2 の E120、param-spec.md「待ちのタグの規則」）。
((:version :0.1)
 (:reserved_wait_tag #x3f)
 (:slot 8 :place :pdm0 :addr 0 :send_wait_tag #x10)
 (:slot 16 :place :pdm0 :addr 4096)
 (:slot 24 :place :pdm0 :addr 131072 :recv_wait_tag #x1e))
