;; even kernel: (data_in, data_out, flag, swap_flags) を slot 8 / 16 / 24 / 32 に割り当てる。
;; ping-pong: data_in @ 0 を読み、 data_out @ 24576 へ書く (odd はこの 2 つを入れ替える)。
;; swap_flags @ 32768 は reduce kernel が distribute で読み直す (addr は reduce.param と一致必須)。
((:version :0.1)
 (:reserved_wait_tag #x3f)
 (:slot 8  :place :pdm0 :addr 0      :send_wait_tag #x10)
 (:slot 16 :place :pdm0 :addr 24576  :recv_wait_tag #x1e)
 (:slot 24 :place :pdm0 :addr 4096   :send_wait_tag #x10)
 (:slot 32 :place :pdm0 :addr 32768  :recv_wait_tag #x1c)
 (:boundary_flags bf0 :place :pdm0 :addr 8192 :send_wait_tag #x10)
 (:buffer nbuf0 :place :pdm0 :addr 16384 :buf_size 4160))
