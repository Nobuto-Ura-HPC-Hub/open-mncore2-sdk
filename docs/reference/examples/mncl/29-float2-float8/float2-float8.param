;; send_wait_tag は、ホストが 0 以外のタグで送るエントリにだけ付ける。distribute4 / collect4 の 1 本は u64 4 x 4096
((:version :0.1)
 (:reserved_wait_tag #x3f)
 (:slot 8 :place :pdm0 :addr 0 :send_wait_tag #x10)
 (:slot 16 :place :pdm0 :addr 4096)
 (:slot 24 :place :pdm0 :addr 20480)
 (:slot 32 :place :pdm0 :addr 24576 :recv_wait_tag #x1e))
