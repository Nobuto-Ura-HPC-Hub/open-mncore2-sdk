;; odd kernel (full 版): even と同一 signature。ping-pong の向きだけ逆。
;; data_in @ 24576 (data_b) を読み、data_out @ 0 (data_a) へ書く。
;; swap_count @ 131072 は even と同じ。id 配列も even と同じ addr 4096 (:identify)。
;; send_wait_tag は、ホストが 0 以外のタグで送るエントリにだけ付ける（タグ 0 で exec の前に送り終えるもの、
;; kernel が PDM に書いたものを読むものには付けない）。vsmlink 0.10.2 の E120（param-spec.md「待ちのタグの規則」）
((:version :0.1)
 (:reserved_wait_tag #x3f)
 (:slot 8  :place :pdm0 :addr 24576)
 (:slot 16 :place :pdm0 :addr 0      :recv_wait_tag #x1e)
 (:slot 24 :place :pdm0 :addr 131072 :recv_wait_tag #x1d)
 (:identify 0 :place :pdm0 :addr 4096 :send_wait_tag #x10)
 (:boundary_flags bf0 :place :pdm0 :addr 8192)
 (:buffer nbuf0 :place :pdm0 :addr 16384 :buf_size 4160))
