;; even kernel (full 版): (data_in, data_out, swap_count) を slot 8 / 16 / 24 に割り当てる。
;; 左メンバ判定は get_global_id なので host flag は無い。id 配列は @identify で配る（addr 4096）。
;; swap_count は inline reduce_add の出力（4 partial sum = 32 byte）。host が毎フェーズ受信して収束判定する。
;; ping-pong: data_in @ 0 (data_a) を読み、data_out @ 24576 (data_b) へ書く。
((:version :0.1)
 (:reserved_wait_tag #x3f)
 (:slot 8  :place :pdm0 :addr 0      :send_wait_tag #x10)
 (:slot 16 :place :pdm0 :addr 24576  :recv_wait_tag #x1e)
 (:slot 24 :place :pdm0 :addr 131072 :recv_wait_tag #x1d)
 (:identify 0 :place :pdm0 :addr 4096 :send_wait_tag #x10)
 (:boundary_flags bf0 :place :pdm0 :addr 8192 :send_wait_tag #x10)
 (:buffer nbuf0 :place :pdm0 :addr 16384 :buf_size 4160))
