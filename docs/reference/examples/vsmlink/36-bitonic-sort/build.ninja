# 36-bitonic-sort: バイトニックソート（4096 個、f64）。隣は @get_hypercube_neighbor で受け取る
#   全体は 78 ステップ（段 s = 1..12、各段で j = s-1..0）。比較・交換のたびに、相手 i XOR 2^j の値を受け取り、
#   (i の bit j) == (i の bit s) なら小さい方、そうでなければ大きい方（dmin / dmax）を新しい値にする。
#   emu:lib と実機の両方で、78 ステップを実行し、全体が昇順に並んでいることを確かめる。
#
# ninja              → vsmlink のみ
# ninja build-e2e    → + assemble3 + C ビルド
# ninja test-emu-lib → emu:lib で 78 ステップを実行・検証
# ninja test-device  → 実機で 78 ステップを実行・検証
# ninja verify       → 短い版（3 ステップ）の vsmlink の出力と expected.vsm の diff

include ../../scripts/sdk.ninja
include ../scripts/vsmlink.ninja
builddir = _build

rule gen_vsm
  command = python3 gen_vsm.py $steps > $out
  description = GEN $out

# --- 全体（78 ステップ） ---
build $builddir/step78._vsm: gen_vsm gen_vsm.py
  steps = 78
build $builddir/step78.vsm: vsmlink $builddir/step78._vsm | sort.param
  vsm     = $builddir/step78._vsm
  param   = sort.param
build $builddir/step78.asm: asm3 $builddir/step78.vsm
build $builddir/step78.idma.dat: asm3_loader $builddir/step78.vsm
  stem = $builddir/step78

# --- 短い版（verify 用、3 ステップ） ---
build $builddir/short._vsm: gen_vsm gen_vsm.py
  steps = 3
build $builddir/short.vsm: vsmlink $builddir/short._vsm | sort.param
  vsm     = $builddir/short._vsm
  param   = sort.param

# --- host C ---
build $builddir/sort_host.o: cc sort_host.c
build $builddir/sort_host: link_exe $builddir/sort_host.o

build build-e2e: phony $
    $builddir/step78.asm $
    $builddir/step78.idma.dat $
    $builddir/sort_host

build test: test_usage

build test-emu-lib: test_emu_lib $builddir/sort_host | $builddir/step78.idma.dat
  args = $builddir/step78.idma.dat 78

build test-device: test_device $builddir/sort_host | $builddir/step78.idma.dat
  args = $builddir/step78.idma.dat 78

default $builddir/step78.vsm

build verify: verify_cmd $builddir/short.vsm
  expected = expected.vsm
  actual = $builddir/short.vsm
