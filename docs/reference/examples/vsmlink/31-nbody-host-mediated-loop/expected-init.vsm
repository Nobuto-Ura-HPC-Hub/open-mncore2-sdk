# ABI PFN3_SBY64
#
# nbody31: kernel 分割版の 3D N 体 vsm。init / reset_acc / accumulate / kick /
# drift / collect_pos の 6 kernel を @kernel_begin/@kernel_end で束ねる。vsmlink がこれを
# kernel ごとの .vsm に分割し、host が accumulate を CHUNK 粒子ずつ繰り返し exec する。
# ** 自動生成: gen_nbody31.py。手で編集しない **
#
#@ @kernel_begin init
# ABI PFN3_SBY64
#
# init: 自粒子 (x,y,z,m) と速度 (vx,vy,vz) を distribute で LM 常駐、定数 (eps2,0.5,1.5,dt)
# を broadcast で LM 常駐、accumulator ax,ay,az を 0 初期化。ホストが 1 回だけ実行する。
# LM0 レイアウト: xi=$lm0 yi=$lm2 zi=$lm4 mi=$lm6 ax=$lm8 ay=$lm10 az=$lm12
#              eps2=$lm14 c_half=$lm16 c_onehalf=$lm18 dt=$lm20
#              vx=$lm22 vy=$lm24 vz=$lm26 dthalf=$lm28
#
# 位置は size 4 [x][y][z][m]、速度は size 3 [vx][vy][vz] の並びで配る。定数 0.5/1.5 は
# rsqrt のニュートン補正、dt は時間積分で使う。dthalf = dt*0.5 は leapfrog の kick 用に
# ここで一度計算する (定数 broadcast は size 4 で満杯なので送らず、dt と 0.5 から作る)。
# 速度の slot には send_wait_tag を付けない (トリガー前に送るので、先頭の wait i10 の
# 時点で PDM に載っている)。
#
# distribute.vsm — @distribute テンプレート

	nop; wait i10
	nop/3
# @distribute _p     from_param 8  size 4 $lm0     # x,y,z,m -> $lm0,2,4,6
# === @distribute _p: PDM $p0 → L2BM → L1BM → $lm0 ===
# (:pdm :directive "@distribute" :id "_p" :slot 8 :place :pdm0 :addr 0 :size 16384 :access :read)
	mvp/n512 $p0@0 $lc0@0.0
	mvp/n512 $p512@0 $lc0@0.1
	mvp/n512 $p1024@0 $lc0@1.0
	mvp/n512 $p1536@0 $lc0@1.1
	mvp/n512 $p2048@0 $lc0@2.0
	mvp/n512 $p2560@0 $lc0@2.1
	mvp/n512 $p3072@0 $lc0@3.0
	mvp/n512i3f $p3584@0 $lc0@3.1
	nop/2
	nop; wait i3f
	nop/5
	l2bmb@0 $lc0 $lb0
	l2bmb@1 $lc64 $lb0
	l2bmb@2 $lc128 $lb0
	l2bmb@3 $lc192 $lb0
	l2bmb@4 $lc256 $lb0
	l2bmb@5 $lc320 $lb0
	l2bmb@6 $lc384 $lb0
	l2bmb@7 $lc448 $lb0
	nop/5
	mvp/n512 $p4096@0 $lc512@0.0
	mvp/n512 $p4608@0 $lc512@0.1
	mvp/n512 $p5120@0 $lc512@1.0
	mvp/n512 $p5632@0 $lc512@1.1
	mvp/n512 $p6144@0 $lc512@2.0
	mvp/n512 $p6656@0 $lc512@2.1
