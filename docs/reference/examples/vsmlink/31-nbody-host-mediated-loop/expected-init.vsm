	mvp/n512i3f $p48640@0 $lc512@3.1
	nop/2
	nop; wait i3f
	nop/5
	l2bmb@0 $lc512 $lb64
	l2bmb@1 $lc576 $lb64
	l2bmb@2 $lc640 $lb64
	l2bmb@3 $lc704 $lb64
	l2bmb@4 $lc768 $lb64
	l2bmb@5 $lc832 $lb64
	l2bmb@6 $lc896 $lb64
	l2bmb@7 $lc960 $lb64
	nop/5
	mvp/n512 $p49152@0 $lc1024@0.0
	mvp/n512 $p49664@0 $lc1024@0.1
	mvp/n512 $p50176@0 $lc1024@1.0
	mvp/n512 $p50688@0 $lc1024@1.1
	mvp/n512 $p51200@0 $lc1024@2.0
	mvp/n512 $p51712@0 $lc1024@2.1
	mvp/n512 $p52224@0 $lc1024@3.0
	mvp/n512i3f $p52736@0 $lc1024@3.1
	nop/2
	nop; wait i3f
	nop/5
	l2bmb@0 $lc1024 $lb128
	l2bmb@1 $lc1088 $lb128
	l2bmb@2 $lc1152 $lb128
	l2bmb@3 $lc1216 $lb128
	l2bmb@4 $lc1280 $lb128
	l2bmb@5 $lc1344 $lb128
	l2bmb@6 $lc1408 $lb128
	l2bmb@7 $lc1472 $lb128
	nop/5
	l1bmd $lb0 $lm22v/1110
# broadcast_load.vsm — @broadcast: PDM の区画を L1BM に載せる部分
# その区画がまだ L1BM に載っていないときだけ展開される
# HW パス: PDM から mvb で全 8 L2BM、 l2bmb で全 64 L1BM へ (64 u64 の区画ごと)

	nop/4
# @broadcast  _const from_param 16 size 4 $lr16    # eps2=$lr16 0.5=$lr18 1.5=$lr20 dt=$lr22
# === @broadcast _const: PDM $p16384 → 全 4096 PE $lr16 ===
	mvb/n64i3f $p16384@0 $lc0
	nop/2
	nop; wait i3f
	nop/5
	l2bmb $lc0 $lb0
# broadcast_use.vsm — @broadcast: L1BM に載っている値を PE に配る部分
# 毎回展開される。載っていなかった場合は直前に broadcast_load.vsm が展開されている
# L1BM の番地は区画の先頭ではなく要求された位置 (ずれは vsmlink が加える)


	nop/5
	l1bmp $lb0 $lr16v
	nop/24
	nop/24
	lpassa $lr16 $lm14       # eps2 -> LM0[7]
	nop/24
	lpassa $lr18 $lm16       # 0.5  -> LM0[8]
	nop/24
	lpassa $lr20 $lm18       # 1.5  -> LM0[9]
	nop/24
	lpassa $lr22 $lm20       # dt   -> LM0[10]
	nop/24
	# dthalf = dt * 0.5  (dt を GRF0 に写す。積は LM1 に出して LM0 の入出力衝突を避け、
	# そのあと LM0[14] に写す)
	lpassa $lm20 $lr0
	nop/2
	dvmulu $lr0 $lm16 $nowrite
	dvfmad $lr0 $lm16 $mauf $ln0
	nop/2
	lpassa $ln0 $lm28
	nop/24
	imm i"0" $r0
	nop/4
	lpassa $lr0 $lm8         # ax = 0 -> LM0[4]
	nop/24
	lpassa $lr0 $lm10        # ay = 0 -> LM0[5]
	nop/24
	lpassa $lr0 $lm12        # az = 0 -> LM0[6]
	nop/24
#@ @kernel_end init
# (:pdm :directive "@broadcast" :id "_const" :slot 16 :place :pdm0 :addr 16384 :size 4 :access :read)
