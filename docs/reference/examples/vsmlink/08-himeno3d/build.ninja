# 08-himeno3d: 3D 7-point stencil（パース確認）
#
# ninja              → vsmlink: _vsm + .param + .stparam → .vsm
#
# カーネル未実装のため E2E なし。
# vecadd カーネルを借りて .stparam のパースが通ることを確認する。

builddir = _build

rule vsmlink
  command = vsmlink $vsm $param $stparam $out && $
            echo "" && $
            echo "  himeno3d.stparam parsed successfully."
  description = VSMLINK $out

rule clean
  command = rm -rf _build
  description = CLEAN

# --- default: vsmlink only ---
build $builddir/out.vsm: vsmlink ../02-vecadd/vecadd._vsm ../02-vecadd/vecadd.param himeno3d.stparam
  vsm = ../02-vecadd/vecadd._vsm
  param = ../02-vecadd/vecadd.param
  stparam = himeno3d.stparam

build clean: clean

default $builddir/out.vsm
