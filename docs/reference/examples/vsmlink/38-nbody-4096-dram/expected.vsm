# ABI PFN3_SBY64
#
# accumulate 分割 (start=0 count=32, newton=3, first=1): 他粒子 32 個
# (グローバル 0..) を DRAM から broadcast size 4 で順に受け、3D softening 付き重力で加速度
# (ax,ay,az) を LM に累積する。first=1 の分割だけ accumulator をリセットする。
# ** 自動生成: gen_accumulate.py。手で編集しない **
# LM0 常駐: xi=$lm0 yi=$lm2 zi=$lm4 mi=$lm6 ax=$lm8 ay=$lm10 az=$lm12
#          eps2=$lm14 c_half=$lm16 c_onehalf=$lm18
# バンク: LM0=$lm LM1=$ln GRF0=$lr GRF1=$ls
	# accumulator を 0 にリセット
	imm i"0" $r0
	nop/4
	lpassa $lr0 $lm8
	nop/24
	lpassa $lr0 $lm10
	nop/24
	lpassa $lr0 $lm12
	nop/24
	# --- ブロック 0: 粒子 0 からの力 ---
# broadcast_load_dram.vsm — @broadcast: DRAM の 64 u64 を L1BM に移動する部分 (:place :group-dram)
# その 64 u64 がまだ L1BM に移動していないときだけ展開される
# HW パス: DRAM から mvb2 で同じグループの 2 つの L2BM へ (全グループで並行)、 l2bmb で全 64 L1BM へ (64 u64 ごと)
# MV 命令の完了はタグと wait で待つ (dev manual 3.6.13)。mvb2 と wait の間の nop/2 は host-dma の example 38-mv-11 (mv-p11.vsm) と同じ形。
# wait の後の l2bmb までは待ちを置かない (wait で完了を待った MV 命令と l2bmb の組は dev manual 3.6.3 に無い)。

# @broadcast _pj from_param 8 size 4 $lr16
# === @broadcast _pj: DRAM $d0 → 全 4096 PE $lr16 ===
	mvb2/n64i3f $d0 $lc0
	nop/2
	nop; wait i3f
	l2bmb $lc0 $lb0
# broadcast_use.vsm — @broadcast: L1BM に移動した値を PE に配る部分
# 毎回展開される。移動していなかった場合は直前に broadcast_load.vsm が展開されている
# L1BM の番地は移動した 64 u64 の先頭ではなく要求された位置 (ずれは vsmlink が加える)


	# 直前の命令が L1BM に書いた場合の待ち。内部マルチキャスト => L1BM -> PE は 3 ステップ（dev manual 3.6.3.5）、
	# L2BM -> L1BM（broadcast_load.vsm の l2bmb）=> L1BM -> PE は 2 ステップ（3.6.3.6）、PE -> L1BM => L1BM -> PE は 2 ステップ（3.6.3.8）
	nop/3
	l1bmp $lb0 $lr16v
	# 直後の命令が $lr16 を読む場合の待ち（dev manual 3.6.3.9。LM0 / LM1 は 2 ステップ）
	nop/2
	nop/2
	dvadd $lr16 -$lm0 $ln0
	nop/2
	dvadd $lr18 -$lm2 $ln2
	nop/2
	dvadd $lr20 -$lm4 $ln4
	nop/2
	dvmulu $ln0 $ln0 $nowrite
	dvfmad $ln0 $ln0 $mauf $ls0
	nop/2
	dvmulu $ln2 $ln2 $nowrite
	dvfmad $ln2 $ln2 $mauf $lr24
	nop/2
	dvadd $ls0 $lr24 $ln6
	nop/2
	dvmulu $ln4 $ln4 $nowrite
	dvfmad $ln4 $ln4 $mauf $ls0
	nop/2
	dvadd $ln6 $ls0 $lr24
	nop/2
	dvadd $lr24 $lm14 $ls0
	nop/2
	drsqrt $ls0 $lr24
	nop/4
	# ニュートン補正: y = y*(1.5 - 0.5*r2*y^2)
	dvmulu $lr24 $lr24 $nowrite
	dvfmad $lr24 $lr24 $mauf $ln6
	nop/2
	dvmulu $ls0 $ln6 $nowrite
	dvfmad $ls0 $ln6 $mauf $lr26
	nop/2
	dvmulu $lm16 $lr26 $nowrite
	dvfmad $lm16 $lr26 $mauf $ln6
	nop/2
	dvadd $lm18 -$ln6 $ls2
	nop/2
	dvmulu $lr24 $ls2 $nowrite
	dvfmad $lr24 $ls2 $mauf $ln6
	nop/2
	lpassa $ln6 $lr24
	nop/2
	# ニュートン補正: y = y*(1.5 - 0.5*r2*y^2)
	dvmulu $lr24 $lr24 $nowrite
	dvfmad $lr24 $lr24 $mauf $ln6
	nop/2
	dvmulu $ls0 $ln6 $nowrite
	dvfmad $ls0 $ln6 $mauf $lr26
	nop/2
	dvmulu $lm16 $lr26 $nowrite
	dvfmad $lm16 $lr26 $mauf $ln6
	nop/2
	dvadd $lm18 -$ln6 $ls2
	nop/2
	dvmulu $lr24 $ls2 $nowrite
	dvfmad $lr24 $ls2 $mauf $ln6
	nop/2
	lpassa $ln6 $lr24
	nop/2
	# ニュートン補正: y = y*(1.5 - 0.5*r2*y^2)
	dvmulu $lr24 $lr24 $nowrite
	dvfmad $lr24 $lr24 $mauf $ln6
	nop/2
	dvmulu $ls0 $ln6 $nowrite
	dvfmad $ls0 $ln6 $mauf $lr26
	nop/2
	dvmulu $lm16 $lr26 $nowrite
	dvfmad $lm16 $lr26 $mauf $ln6
	nop/2
	dvadd $lm18 -$ln6 $ls2
	nop/2
	dvmulu $lr24 $ls2 $nowrite
	dvfmad $lr24 $ls2 $mauf $ln6
	nop/2
	lpassa $ln6 $lr24
	nop/2
	dvmulu $lr24 $lr24 $nowrite
	dvfmad $lr24 $lr24 $mauf $ls0
	nop/2
	dvmulu $ls0 $lr24 $nowrite
	dvfmad $ls0 $lr24 $mauf $ln6
	nop/2
	dvmulu $lr22 $ln6 $nowrite
	dvfmad $lr22 $ln6 $mauf $ls0
	nop/2
	dvmulu $ls0 $ln0 $nowrite
	dvfmad $ls0 $ln0 $mauf $lr24
	nop/2
	dvadd $lm8 $lr24 $ln8
	nop/2
	lpassa $ln8 $lm8
	nop/24
	dvmulu $ls0 $ln2 $nowrite
	dvfmad $ls0 $ln2 $mauf $lr24
	nop/2
	dvadd $lm10 $lr24 $ln10
	nop/2
	lpassa $ln10 $lm10
	nop/24
	dvmulu $ls0 $ln4 $nowrite
	dvfmad $ls0 $ln4 $mauf $lr24
	nop/2
	dvadd $lm12 $lr24 $ln12
	nop/2
	lpassa $ln12 $lm12
	nop/24
