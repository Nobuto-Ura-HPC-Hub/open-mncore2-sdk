# 02-vecadd: double-vecadd (4096 PE, dvadd FP 加算)
#
# ninja              → vsmlink: _vsm + .param + .stparam → .vsm
# ninja verify       → expected.vsm との diff 検証
# ninja build-e2e    → + assemble3 + host C ビルド (emu:lib)
# ninja test         → + emu:lib で実行・検証
#
# 前提: SDK activate 済み (vsmlink, assemble3, mnc2.h が利用可能)

include ../../scripts/sdk.ninja
include ../scripts/vsmlink.ninja
builddir = _build

rule verify_cmd
  command = diff -u $expected $actual && echo "OK: vecadd output matches expected"
  description = VERIFY $actual

# --- default: vsmlink only ---
build $builddir/vecadd.vsm: vsmlink vecadd._vsm vecadd.param vecadd.stparam
  vsm = vecadd._vsm
  param = vecadd.param
  stparam = vecadd.stparam

# --- verify: golden data ---
build verify: verify_cmd $builddir/vecadd.vsm
  expected = expected.vsm
  actual = $builddir/vecadd.vsm

# --- build-e2e: assemble + host C ---
build $builddir/vecadd.asm: asm3 $builddir/vecadd.vsm
build $builddir/vecadd.idma.dat: asm3_loader $builddir/vecadd.vsm
  stem = $builddir/vecadd

build $builddir/test_vecadd.o: cc test_vecadd.c
build $builddir/test_vecadd: link_exe $builddir/test_vecadd.o

build build-e2e: phony $builddir/vecadd.asm $builddir/vecadd.idma.dat $builddir/test_vecadd

# --- test: run E2E ---
build test: test_usage
build test-emu-lib: test_emu_lib $builddir/test_vecadd | $builddir/vecadd.idma.dat
build test-device: test_device $builddir/test_vecadd | $builddir/vecadd.idma.dat

build clean: clean

default $builddir/vecadd.vsm
