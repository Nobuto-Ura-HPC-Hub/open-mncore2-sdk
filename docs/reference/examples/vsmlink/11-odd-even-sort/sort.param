((:version :0.1)
 (:reserved_wait_tag #x3f)
 (:slot 8  :place :pdm0 :addr 0 :send_wait_tag #x10 :recv_wait_tag #x1e)      ; data A (sort_even 入力, sort_odd 出力)
 (:slot 16 :place :pdm0 :addr 4096 :send_wait_tag #x10 :recv_wait_tag #x1e)   ; data B (sort_even 出力, sort_odd 入力)
 (:slot 24 :place :pdm0 :addr 8192 :send_wait_tag #x10 :recv_wait_tag #x1f)   ; swap_flags (各フェーズ出力, 2nd @collect)
 (:identify 0 :place :pdm0 :addr 12288 :send_wait_tag #x10)  ; PE ID [0..4095] (C ホストが事前設定)
 (:boundary_flags bf1 :place :pdm0 :addr 16384 :send_wait_tag #x10)
 (:buffer nbuf0 :place :pdm0 :addr 24576 :buf_size 4160))
