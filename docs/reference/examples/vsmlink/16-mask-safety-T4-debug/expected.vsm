# ABI PFN3_SBY64
#
# T4: @stencil in nested if-if (flag1 ∧ flag2) — debug_read 版
#
# PDM layout:
#   slot 8:  input  (stencil source, 1 LW/PE)
#   slot 24: flag1  (outer if: 0=true, nonzero=false)
#   slot 32: flag2  (inner if: 0=true, nonzero=false)
#
# if(flag1) {
#     r16=1
#     if(flag2) { r16=5; @stencil; r18=1 } else { r16=9 }
# } else {
#     r16=2
#     if(flag2) { r16=6 } else { r16=10 }
# }
#
# Expected (r16,r18): TT→5,1  TF→9,0  FT→6,0  FF→10,0
#
# Verification: debug_read で GRF0 から r16/r18 を直接読み出す。
# @collect 不要のため wd タグ衝突の問題なし。
# GRF0 の debug_read は emu:lib と emu:process で使える。実機は対応しない
# (libmnc2 の api-reference.md の「対応メモリ領域」)。
#
# distribute.vsm — @distribute テンプレート

# @distribute _arg_a from_param 8 size 1 $lm0
# === @distribute _arg_a: PDM $p0 → L2BM → L1BM → $lm0 ===
# (:pdm :directive "@distribute" :id "_arg_a" :slot 8 :place :pdm0 :addr 0 :size 4096 :access :read)
	mvp/n512 $p0@0 $lc0@0.0
	mvp/n512 $p512@0 $lc0@0.1
	mvp/n512 $p1024@0 $lc0@1.0
	mvp/n512 $p1536@0 $lc0@1.1
	mvp/n512 $p2048@0 $lc0@2.0
	mvp/n512 $p2560@0 $lc0@2.1
	mvp/n512 $p3072@0 $lc0@3.0
	mvp/n512i3f $p3584@0 $lc0@3.1
	nop/2
	nop; wait i3f
	nop/5
	l2bmb@0 $lc0 $lb0
	l2bmb@1 $lc64 $lb0
	l2bmb@2 $lc128 $lb0
	l2bmb@3 $lc192 $lb0
	l2bmb@4 $lc256 $lb0
	l2bmb@5 $lc320 $lb0
	l2bmb@6 $lc384 $lb0
	l2bmb@7 $lc448 $lb0
	nop/5
	l1bmd $lb0 $lm0v/1000
# distribute.vsm — @distribute テンプレート

	nop/4
# @distribute _arg_flag1 from_param 24 size 1 $lm8
# === @distribute _arg_flag1: PDM $p4096 → L2BM → L1BM → $lm8 ===
# (:pdm :directive "@distribute" :id "_arg_flag1" :slot 24 :place :pdm0 :addr 4096 :size 4096 :access :read)
	mvp/n512 $p4096@0 $lc0@0.0
	mvp/n512 $p4608@0 $lc0@0.1
	mvp/n512 $p5120@0 $lc0@1.0
	mvp/n512 $p5632@0 $lc0@1.1
	mvp/n512 $p6144@0 $lc0@2.0
	mvp/n512 $p6656@0 $lc0@2.1
	mvp/n512 $p7168@0 $lc0@3.0
	mvp/n512i3f $p7680@0 $lc0@3.1
	nop/2
	nop; wait i3f
	nop/5
	l2bmb@0 $lc0 $lb0
	l2bmb@1 $lc64 $lb0
	l2bmb@2 $lc128 $lb0
	l2bmb@3 $lc192 $lb0
	l2bmb@4 $lc256 $lb0
	l2bmb@5 $lc320 $lb0
	l2bmb@6 $lc384 $lb0
	l2bmb@7 $lc448 $lb0
	nop/5
	l1bmd $lb0 $lm8v/1000
# distribute.vsm — @distribute テンプレート

	nop/4
	nop; wait i10
	nop/3
# @distribute _arg_flag2 from_param 32 size 1 $lm16
# === @distribute _arg_flag2: PDM $p8192 → L2BM → L1BM → $lm16 ===
# (:pdm :directive "@distribute" :id "_arg_flag2" :slot 32 :place :pdm0 :addr 8192 :size 4096 :access :read)
	mvp/n512 $p8192@0 $lc0@0.0
	mvp/n512 $p8704@0 $lc0@0.1
	mvp/n512 $p9216@0 $lc0@1.0
	mvp/n512 $p9728@0 $lc0@1.1
	mvp/n512 $p10240@0 $lc0@2.0
	mvp/n512 $p10752@0 $lc0@2.1
	mvp/n512 $p11264@0 $lc0@3.0
	mvp/n512i3f $p11776@0 $lc0@3.1
	nop/2
	nop; wait i3f
	nop/5
	l2bmb@0 $lc0 $lb0
	l2bmb@1 $lc64 $lb0
	l2bmb@2 $lc128 $lb0
	l2bmb@3 $lc192 $lb0
	l2bmb@4 $lc256 $lb0
	l2bmb@5 $lc320 $lb0
	l2bmb@6 $lc384 $lb0
	l2bmb@7 $lc448 $lb0
	nop/5
	l1bmd $lb0 $lm16v/1000
	nop/24
	lpassa $lm0 $lr0
# r16=0, r18=0
	imm i"0" $r16
	imm i"0" $r17
	imm i"0" $r18
	imm i"0" $r19
	nop
	nop
# ── Condition setup (all outside maskr, lxor/lor-based) ──
# Step 1: Compute NOT flag values → save to LM
# lr28 = (0, 1) を定数として用意
	imm i"0" $r28
	imm i"1" $r29
	nop
	nop
# NOT flag1 → lr30 → lm24
	lxor $lm8 $lr28 $lr30
	nop
	nop
	nop/24
	lpassa $lr30 $lm24
	nop
	nop
	nop/24
# NOT flag2 → lr30 → lm32 (lr28 は operand なので変更されない)
	lxor $lm16 $lr28 $lr30
	nop
	nop
	nop/24
	lpassa $lr30 $lm32
	nop
	nop
	nop/24
# Step 2: Set all 6 omr values
# omr15 = flag1
	imm i"0" $r28
	imm i"0" $r29
	nop
	nop
	lxor $lm8 $lr28 $omr15
	nop
	nop
# omr8 = NOT flag1
	imm i"0" $r28
	imm i"0" $r29
	nop
	nop
	lxor $lm24 $lr28 $omr8
	nop
	nop
# omr7 = flag1 AND flag2: lor(flag1, flag2)
	lpassa $lm8 $lr28
	nop
	nop
	nop/24
	lor $lm16 $lr28 $omr7
	nop
	nop
# omr6 = flag1 AND NOT flag2: lor(flag1, NOT_flag2)
	lpassa $lm8 $lr28
	nop
	nop
	nop/24
	lor $lm32 $lr28 $omr6
	nop
	nop
# omr5 = NOT flag1 AND flag2: lor(NOT_flag1, flag2)
	lpassa $lm24 $lr28
	nop
	nop
	nop/24
	lor $lm16 $lr28 $omr5
	nop
	nop
# omr4 = NOT flag1 AND NOT flag2: lor(NOT_flag1, NOT_flag2)
	lpassa $lm24 $lr28
	nop
	nop
	nop/24
	lor $lm32 $lr28 $omr4
	nop
	nop
# ── Test sections ──
# NOTE: lpassa は maskr を無視する。maskr 内では ipassa を使うこと。
# === outer if (flag1) { r16=1 ===
	imm i"1" $r24
	imm i"0" $r25
	nop
	nop
	  maskr 15
	ipassa $lr24 $lr16
	  mask 0
	nop
	nop
# inner if (flag1 ∧ flag2): r16=5, @stencil, r18=1
	imm i"5" $r24
	imm i"0" $r25
	nop
	nop
	  maskr 7
	ipassa $lr24 $lr16
	  mask 0
	nop
	nop
# @stencil
# boundary_flags.vsm — @boundary_flags テンプレート

# @boundary_flags bf1 0 $lr416 data_edge_left data_edge_right cross_chip_left cross_chip_right cross_L2B_left cross_L2B_right cross_L1B_left cross_L1B_right cross_MAB_left cross_MAB_right
# === @boundary_flags bf1: PDM → $lr416 ===
# -- @boundary_flags distribute: PDM $p12288 → L2BM → L1BM → $lr416 --
	mvp/n512 $p12288@0 $lc0@0.0
	mvp/n512 $p12800@0 $lc0@0.1
	mvp/n512 $p13312@0 $lc0@1.0
	mvp/n512 $p13824@0 $lc0@1.1
	mvp/n512 $p14336@0 $lc0@2.0
	mvp/n512 $p14848@0 $lc0@2.1
	mvp/n512 $p15360@0 $lc0@3.0
	mvp/n512i3f $p15872@0 $lc0@3.1
	nop/2
	nop; wait i3f
	nop/5
	l2bmb@0 $lc0 $lb0
	l2bmb@1 $lc64 $lb0
	l2bmb@2 $lc128 $lb0
	l2bmb@3 $lc192 $lb0
	l2bmb@4 $lc256 $lb0
	l2bmb@5 $lc320 $lb0
	l2bmb@6 $lc384 $lb0
	l2bmb@7 $lc448 $lb0
	nop/5
	l1bmd $lb0 $lr416v/1000
	nop/24
#@ @alloc left :omr 9 10 11 12 :grf0 200 202 204 206 208 210 212 214 216 218 220 :n 0
#@ @get_neighbor $lr400 -1 $lm0 bf1 nbuf0 left
# get_neighbor_left_clamp.vsm — @get_neighbor offset=-1 clamp テンプレート
#
# put/get モデル: PDM0 上の専用バッファ（:buffer）を使用。
# L1B7 のみ collect する minimal 方式。
# clamp: data_edge の PE は自分自身の値を返す。
#
# omr 導出: ixor でワンホット完全一致を検出
# 結果選択: within MAB をデフォルトにし、maskr で上書き
#
# バッファレイアウト (buf_size = 4160):
#   512 u64 間隔で 9 スロット。各スロットの先頭 64 u64 のみ使用。
#   put: offset 512, 1024, ..., 4096 (8 L2B の L1B7 データ)
#   get: offset 0, 512, ..., 3584 (1 L2B 分ずらして読む = left)
#   offset 0..63 は edge 領域（get 時のずらし先）
#
# レジスタ使用 (grf0: r0-r10, omr: omr0-omr3, n: n0):
#   r0: 入力データ  r1: ゼロ  r2: cross_L2B  r3: cross_L1B
#   r4: cross_MAB   r5: within_MAB  r6: omr 一時
#   r7: imm cross_L2B マスク (_hi/_lo)
#   r8: imm cross_L1B マスク (_hi/_lo)
#   r9: imm cross_MAB マスク (_hi/_lo)
#   r10: imm data_edge マスク (_hi/_lo)

# ゼロレジスタ
lxor $lr202 $lr202 $lr202

# 入力データ → GRF
lpassa $lm0 $lr200
nop
nop

# ============================================================
# put: PE → L1BM → L2BM → PDM（L1B7 のみ）
# ============================================================
l1bmd $lr200v $lb128
nop/10

l2bm@7 $lb128 $lc960
nop/3

mvp/n64 $lc960@0.0 $p16896@0
mvp/n64i3f $lc960@0.1 $p17408@0
nop/3
nop; wait i3f
mvp/n64 $lc960@1.0 $p17920@0
mvp/n64i3f $lc960@1.1 $p18432@0
nop/3
nop; wait i3f
mvp/n64 $lc960@2.0 $p18944@0
mvp/n64i3f $lc960@2.1 $p19456@0
nop/3
nop; wait i3f
mvp/n64 $lc960@3.0 $p19968@0
mvp/n64i3f $lc960@3.1 $p20480@0
nop/3
nop; wait i3f
nop/5

# ============================================================
# get: PDM → L2BM → L1BM → PE（1 L2B 分ずらして読む = left）
# ============================================================
mvp/n64 $p16384@0 $lc1472@0.0
mvp/n64 $p16896@0 $lc1472@0.1
mvp/n64 $p17408@0 $lc1472@1.0
mvp/n64 $p17920@0 $lc1472@1.1
mvp/n64 $p18432@0 $lc1472@2.0
mvp/n64 $p18944@0 $lc1472@2.1
mvp/n64 $p19456@0 $lc1472@3.0
mvp/n64i3f $p19968@0 $lc1472@3.1
nop/2
nop; wait i3f
nop/5

# L2BM → L1BM → PE
l2bmb@0 $lc1472 $lb128
nop/6
l1bmd+1 $lb128 $lr204v/1000
nop/2
msl $lr204 $lr204

# ============================================================
# cross L1B (L2BM 経由)
# ============================================================
nop/2
l1bmd $lr200v $lb128
nop/10

l2bm@0 $lb128 $lc512
l2bm@1 $lb128 $lc576
l2bm@2 $lb128 $lc640
l2bm@3 $lb128 $lc704
l2bm@4 $lb128 $lc768
l2bm@5 $lb128 $lc832
l2bm@6 $lb128 $lc896
l2bm@7 $lb128 $lc960
nop/3

l2bmb@1 $lc512 $lb128
l2bmb@2 $lc576 $lb128
l2bmb@3 $lc640 $lb128
l2bmb@4 $lc704 $lb128
l2bmb@5 $lc768 $lb128
l2bmb@6 $lc832 $lb128
l2bmb@7 $lc896 $lb128
nop/6

l1bmd+1 $lb128 $lr206v/1000
nop/2
msl $lr206 $lr206

# ============================================================
# cross MAB + within MAB
# ============================================================
nop/2
l1bmd $lr200v $lb0
nop/2

l1bmd+1 $lb0 $lr208v/1000
nop/2
msl $lr208 $lr208

nop/2
msl $lm0 $lr210

# ============================================================
# omr 導出 (ixor ワンホット完全一致)
# ============================================================
# cross_L2B_left = bit5 = 32
imm i"0" $r214
imm i"32" $r215

# cross_L1B_left = bit3 = 8
imm i"0" $r216
imm i"8" $r217

# cross_MAB_left = bit1 = 2
imm i"0" $r218
imm i"2" $r219

# data_edge_left = bit9 = 512
imm i"0" $r220
imm i"512" $r221

nop/2

# omr0: cross_L2B_left
lpassa $lr416 $ln0
nop/2
ixor $ln0 $lr214 $lr212
nop/2
lpassa $lr212 $omr9

# omr1: cross_L1B_left
nop
lpassa $lr416 $ln0
nop/2
ixor $ln0 $lr216 $lr212
nop/2
lpassa $lr212 $omr10

# omr2: cross_MAB_left
nop
lpassa $lr416 $ln0
nop/2
ixor $ln0 $lr218 $lr212
nop/2
lpassa $lr212 $omr11

# omr3: data_edge_left
nop
lpassa $lr416 $ln0
nop/2
ixor $ln0 $lr220 $lr212
nop/2
lpassa $lr212 $omr12

# ============================================================
# 結果選択 (within MAB デフォルト + maskr 上書き)
# ============================================================

# default: within MAB
nop/2
lpassa $lr210 $lr400

# cross_MAB_left で上書き
nop/2
  maskr 11
ipassa $lr208 $lr400
  mask 0

# cross_L1B_left で上書き
nop/2
  maskr 10
ipassa $lr206 $lr400
  mask 0

# cross_L2B_left で上書き
nop/2
  maskr 9
ipassa $lr204 $lr400
  mask 0

# clamp: data_edge_left → self で上書き
nop/2
  maskr 12
ipassa $lm0 $lr400
  mask 0

# 暫定: 直後に $lr400 を使う命令が来ると hazard になるため。 後で精査して正確な数に置き換える
nop/2
#@ @free left
# r18 = 1 (stencil completion)
	imm i"1" $r24
	imm i"0" $r25
	nop
	nop
	  maskr 7
	ipassa $lr24 $lr18
	  mask 0
	nop
	nop
# inner else (flag1 ∧ !flag2): r16=9
	imm i"9" $r24
	imm i"0" $r25
	nop
	nop
	  maskr 6
	ipassa $lr24 $lr16
	  mask 0
	nop
	nop
# === } outer if end ===
# === outer else (!flag1) { r16=2 ===
	imm i"2" $r24
	imm i"0" $r25
	nop
	nop
	  maskr 8
	ipassa $lr24 $lr16
	  mask 0
	nop
	nop
# inner if in else (!flag1 ∧ flag2): r16=6
	imm i"6" $r24
	imm i"0" $r25
	nop
	nop
	  maskr 5
	ipassa $lr24 $lr16
	  mask 0
	nop
	nop
# inner else in else (!flag1 ∧ !flag2): r16=10
	imm i"10" $r24
	imm i"0" $r25
	nop
	nop
	  maskr 4
	ipassa $lr24 $lr16
	  mask 0
	nop
	nop
# === } outer else end ===
# (no @collect — debug_read で直接読み出す)
