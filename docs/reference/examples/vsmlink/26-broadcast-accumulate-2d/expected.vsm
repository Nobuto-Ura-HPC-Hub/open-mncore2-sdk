# ABI PFN3_SBY64
#
# 段階3b accumulate: 他粒子 (xj,yj,mj) を broadcast で受け取り、自粒子 (LM 常駐) との
# 質量重み付き総和を accumulator ax,ay に加算する。ホストが N 回実行する。
# LM0 常駐: xi=$lm0, yi=$lm2, ax=$lm4, ay=$lm6, mi=$lm10
# バンク: LM0=$lm LM1=$ln GRF0=$lr GRF1=$ls
#
# rsqrt を使わない。rsqrt は精度 5 ビット程度の近似で、これが唯一のビット不一致要因に
# なる。加算と乗算だけで組めばホストが同じ順序で再現でき、許容誤差ゼロで照合できる。
# したがって逆二乗則の 1/r^3 は落とし、次を計算する。
#
#   ax += mj * (xi - xj),  ay += mj * (yi - yj)
#
# 重力ではないが、全対全総和のデータの流れは N 体と同じである。
#
	# 他粒子を 2 つの broadcast に分けて配る。位置は j ごとに変わり、質量は星ごとに
	# 決まる値なので、ホスト側で別々の配列から別々の PDM 領域へ送る。
# broadcast_load.vsm — @broadcast: PDM の区画を L1BM に載せる部分
# その区画がまだ L1BM に載っていないときだけ展開される
# HW パス: PDM から mvb で全 8 L2BM、 l2bmb で全 64 L1BM へ (64 u64 の区画ごと)

	nop; wait i10
	nop/3
# @broadcast _pj from_param 8  size 2 $lr16    # xj -> $lr16, yj -> $lr18
# === @broadcast _pj: PDM $p12288 → 全 4096 PE $lr16 ===
	mvb/n64i3f $p12288@0 $lc0
	nop/2
	nop; wait i3f
	nop/5
	l2bmb $lc0 $lb0
# broadcast_use.vsm — @broadcast: L1BM に載っている値を PE に配る部分
# 毎回展開される。載っていなかった場合は直前に broadcast_load.vsm が展開されている
# L1BM の番地は区画の先頭ではなく要求された位置 (ずれは vsmlink が加える)


	nop/5
	l1bmp $lb0 $lr16v/1100
	nop/24
# broadcast_load.vsm — @broadcast: PDM の区画を L1BM に載せる部分
# その区画がまだ L1BM に載っていないときだけ展開される
# HW パス: PDM から mvb で全 8 L2BM、 l2bmb で全 64 L1BM へ (64 u64 の区画ごと)

	nop/4
# @broadcast _mj from_param 16 size 1 $lr20    # mj -> $lr20
# === @broadcast _mj: PDM $p12352 → 全 4096 PE $lr20 ===
	mvb/n64i3f $p12352@0 $lc0
	nop/2
	nop; wait i3f
	nop/5
	l2bmb $lc0 $lb64
# broadcast_use.vsm — @broadcast: L1BM に載っている値を PE に配る部分
# 毎回展開される。載っていなかった場合は直前に broadcast_load.vsm が展開されている
# L1BM の番地は区画の先頭ではなく要求された位置 (ずれは vsmlink が加える)


	nop/5
	l1bmp $lb64 $lr20v/1000
	nop/24
	# dx = xi - xj  (LM0 - GRF0 -> LM1)
	nop/24
	dvadd $lm0 -$lr16 $ln0
	nop/2
	# dy = yi - yj  (LM0 - GRF0 -> LM1)
	dvadd $lm2 -$lr18 $ln2
	nop/2
	# fx = mj * dx  (GRF0 * LM1 -> GRF1)
	dvmulu $lr20 $ln0 $nowrite
	dvfmad $lr20 $ln0 $mauf $ls0
	nop/2
	# fy = mj * dy  (GRF0 * LM1 -> GRF1)
	dvmulu $lr20 $ln2 $nowrite
	dvfmad $lr20 $ln2 $mauf $ls2
	nop/2
	# ax += fx  (LM0 + GRF1 -> LM1, LM0 に書き戻し)
	dvadd $lm4 $ls0 $ln4
	nop/2
	lpassa $ln4 $lm4
	nop/24
	# ay += fy
	dvadd $lm6 $ls2 $ln6
	nop/2
	lpassa $ln6 $lm6
	nop/24
# (:pdm :directive "@broadcast" :id "_pj" :slot 8 :place :pdm0 :addr 12288 :size 2 :access :read)
# (:pdm :directive "@broadcast" :id "_mj" :slot 16 :place :pdm0 :addr 12352 :size 1 :access :read)
