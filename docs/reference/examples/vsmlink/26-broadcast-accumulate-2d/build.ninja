# 26-broadcast-accumulate-2d: distribute / broadcast / collect (size 2) を使った
# 2D 質量重み付き総和 (段階実装)
#
# 段階1: distribute + broadcast の辻褄確認 (dist_bcast) -- 検証済み (記録として保持)
# 段階3b: init + ホストループ + LM 累積 + collect -- 現在
#
# ninja              → vsmlink (.vsm 生成)
# ninja build-e2e    → + assemble3 + host C ビルド
# ninja test-emu-lib → + emu:lib で実行・検証
# ninja test-device  → + 実機で実行

include ../../scripts/sdk.ninja
include ../scripts/vsmlink.ninja
builddir = _build

# --- init (自粒子 distribute + ax,ay=0) ---
build $builddir/init.vsm: vsmlink init._vsm init.param accumulate2d.stparam
  vsm = init._vsm
  param = init.param
  stparam = accumulate2d.stparam
build $builddir/init.idma.dat: asm3_loader $builddir/init.vsm
  stem = $builddir/init

# --- accumulate (broadcast 他粒子 + 総和 + LM 累積) ---
build $builddir/accumulate.vsm: vsmlink accumulate._vsm accumulate.param accumulate2d.stparam
  vsm = accumulate._vsm
  param = accumulate.param
  stparam = accumulate2d.stparam
build $builddir/accumulate.idma.dat: asm3_loader $builddir/accumulate.vsm
  stem = $builddir/accumulate

# --- collect (ax,ay 回収) ---
build $builddir/collect.vsm: vsmlink collect._vsm collect.param accumulate2d.stparam
  vsm = collect._vsm
  param = collect.param
  stparam = accumulate2d.stparam
build $builddir/collect.idma.dat: asm3_loader $builddir/collect.vsm
  stem = $builddir/collect

# --- landing (段階1: l1bmp 着地レジスタ実測。単独ターゲット test-landing で実行) ---
build $builddir/landing.vsm: vsmlink landing._vsm landing.param accumulate2d.stparam
  vsm = landing._vsm
  param = landing.param
  stparam = accumulate2d.stparam
build $builddir/landing.idma.dat: asm3_loader $builddir/landing.vsm
  stem = $builddir/landing
build $builddir/test_landing.o: cc test_landing.c
build $builddir/test_landing: link_exe $builddir/test_landing.o
build test-landing: test_emu_lib $builddir/test_landing | $builddir/landing.idma.dat

# --- host C ---
build $builddir/test_accumulate.o: cc test_accumulate.c
build $builddir/test_accumulate: link_exe $builddir/test_accumulate.o

# --- ビルド段階 phony ---
build build-e2e: phony $builddir/init.idma.dat $builddir/accumulate.idma.dat $builddir/collect.idma.dat $builddir/test_accumulate

# --- test targets ---
build test: test_usage
build test-emu-lib: test_emu_lib $builddir/test_accumulate | $builddir/init.idma.dat $builddir/accumulate.idma.dat $builddir/collect.idma.dat
build test-device: test_device $builddir/test_accumulate | $builddir/init.idma.dat $builddir/accumulate.idma.dat $builddir/collect.idma.dat

build clean: clean

default $builddir/accumulate.vsm
