# ABI PFN3_SBY64
#
# 1D 3-point stencil: output[i] = left[i] + center[i] + right[i]
# （@boundary_flags_compute: HW レジスタから境界フラグを計算。PDM 不要）
#
	@alloc bfcomp :omr 1 2 3 4 :grf0 200 32 34 40 42 44 46 :n 0
	@boundary_flags_compute bf1 0 $lr416 bfcomp
	@free bfcomp
	@distribute _arg_a from_param 8 size 1 $lm0
	lpassa $lm0 $lr0
	@alloc left :omr 9 10 11 12 :grf0 200 202 204 206 208 210 212 214 216 218 220 :n 0
	@get_neighbor $lr400 -1 $lm0 bf1 nbuf0 left
	@free left
	@alloc right :omr 9 10 11 12 :grf0 200 202 204 206 208 210 212 214 216 218 220 :n 0
	@get_neighbor $lr408 +1 $lm0 bf1 nbuf0 right
	@free right
	lpassa $lr400 $lm0
	nop
	nop
	dvadd $lr0 $lm0 $lr0
	lpassa $lr408 $lm0
	nop
	nop
	dvadd $lr0 $lm0 $lr0
	nop
	nop
	lpassa $lr0 $ln4088
	@collect _arg_c to_param 16 size 1 $ln4088
