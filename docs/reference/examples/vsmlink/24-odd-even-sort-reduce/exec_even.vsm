# exec_even.vsm — 偶数フェーズ (even phase)
#
# 組: (PE0,PE1), (PE2,PE3) — 全て MAB 内。cross MAB 不要。
# 偶数PE (bit0=0): new_val = min(my, right_neighbor) — 組の左側
# 奇数PE (bit0=1): new_val = max(my, left_neighbor) — 組の右側
#
# 入力: LM0[0], 出力: LM0[0] (上書き) + LM0[8] ($lm16 = swap_flag)

nop
nop

# === 定数 ===
imm i"0" $r72
imm i"0" $r73
nop/4
lpassa $lr72 $ln8
nop/24

imm i"0" $r0
imm i"1" $r1
nop/4
lpassa $lr0 $ln0
nop/24

# === my_val → GRF1 ===
lpassa $lm0 $lr0
nop
nop
lpassa $lr0 $ln16
nop/24

# === 隣接値取得 (MAB 内のみ) ===
msl $lm0 $lr400/1111
nop
nop
msr $lm0 $lr408
nop
nop

# === min(right, my) と max(left, my) ===
lmin $lr408 $ln16 $lr200
nop
lmax $lr400 $ln16 $lr208
nop
nop

# === 偶奇選択 ===
# デフォルト: min with right (偶数PE 用)
lxor $lr200 $ln8 $lr40
nop
nop

# bit0 = subpeid & 1
iand $subpeid $ln0 $lr16
nop/4
# 奇数PE (bit0==1 → XOR 1 = 0 → omr=0 → maskr 発動)
lxor $lr16 $ln0 $omr2
nop
nop
nop
nop
nop
nop
# 奇数PE: max with left に上書き
  maskr 2
ipassa $lr208 $lr40
  mask 0
nop
nop

# === swap 検出 ===
lxor $lr40 $ln16 $omr4
nop
nop
imm i"0" $r48
imm i"1" $r49
nop
nop
  maskr 4
ipassa $lr72 $lr48
  mask 0
nop
nop

# === 結果保存 ===
# new_val → LM0[0] (次パスの入力として上書き)
lpassa $lr40 $lm0
# swap_flag → LM0[8]
lpassa $lr48 $lm16
nop
nop
nop/24
