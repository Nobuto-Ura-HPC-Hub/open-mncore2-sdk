# ABI PFN3_SBY64
#
# @boundary_flags 検証: 外部 golden data で $lr416 を上書き → stencil
# OK ケース（正しい golden）→ PASS、NG ケース（ゼロ golden）→ 結果変化
#
# golden は $lm8 に配布（$lm0 は入力データ用 → @stencil が読む）
#
	@distribute _arg_a from_param 8 size 1 $lm0
	lpassa $lm0 $lr0
	@boundary_flags bf1 0 $lr416 data_edge_left data_edge_right cross_chip_left cross_chip_right cross_L2B_left cross_L2B_right cross_L1B_left cross_L1B_right cross_MAB_left cross_MAB_right
	@distribute _golden from_param 24 size 1 $lm8
	lpassa $lm8 $lr416
	nop/24
	@alloc left :omr 9 10 11 12 :grf0 200 202 204 206 208 210 212 214 216 218 220 :n 0
	@get_neighbor $lr400 -1 $lm0 bf1 nbuf0 left
	@free left
	@alloc right :omr 9 10 11 12 :grf0 200 202 204 206 208 210 212 214 216 218 220 :n 0
	@get_neighbor $lr408 +1 $lm0 bf1 nbuf0 right
	@free right
	lpassa $lr400 $lm0
	nop
	nop
	dvadd $lr0 $lm0 $lr0
	lpassa $lr408 $lm0
	nop
	nop
	dvadd $lr0 $lm0 $lr0
	nop
	nop
	lpassa $lr0 $ln4088
	@collect _arg_c to_param 16 size 1 $ln4088
