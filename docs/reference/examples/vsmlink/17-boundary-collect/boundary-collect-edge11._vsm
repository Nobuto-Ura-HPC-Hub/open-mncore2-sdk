# boundary-collect: HW レジスタから計算した排他的 10bit フラグを PDM に回収する（廃止した @boundary_flags_compute の展開をそのまま書いた）
#
# 排他的フラグ: 各 PE に最大 1 ビット (cross_group 廃止)
#   bit[0] = cross_MAB_right   bit[1] = cross_MAB_left
#   bit[2] = cross_L1B_right   bit[3] = cross_L1B_left
#   bit[4] = cross_L2B_right   bit[5] = cross_L2B_left
#   bit[6] = cross_chip_right  bit[7] = cross_chip_left
#   bit[8] = data_edge_right   bit[9] = data_edge_left
#
# 出力:
#   to_param 8: 10bit 境界フラグ (4096 PE × 1 u64)

	# 以下は、廃止した @boundary_flags_compute（data_edge 11）の展開をそのまま書いたもの:
	#   @boundary_flags_compute bf1 0 $lr416 bfcomp
# boundary_flags_compute.vsm — @boundary_flags_compute テンプレート
#
# HW レジスタ ($subpeid, $mabid, $l1bid, $l2bid) から
# 排他的 10bit ワンホットフラグを計算し $lr416 に書き込む。
#
# レジスタ使用 (grf0: r0-r4, omr: omr0-omr3, n: n0):
#   r0: 出力中間  r1: ゼロ  r2: imm (_hi/_lo)
#   r3: acc (_hi/_lo)  r4: T1
#   omr0-omr3: 条件計算用（left/right で使い回し）
#   n0: LM1 作業用
# -- @boundary_flags_compute: 排他的 10bit → $lr416 --
	lxor $lr32 $lr32 $lr32
	nop/4
	lpassa $lr32 $ln0
	nop/24
	imm i"0" $r200
	imm i"0" $r201
	nop/4
# -- right flags --
	imm i"0" $r34
	imm i"3" $r35
	nop/4
	lpassa $lr34 $ln0
	lpassa $subpeid $lr40
	nop/24
	lxor $lr40 $ln0 $omr1
	imm i"0" $r34
	imm i"3" $r35
	nop/4
	lpassa $lr34 $ln0
	lpassa $subpeid $lr40
	nop/24
	lxor $lr40 $ln0 $lr40
	nop/4
	imm i"0" $r34
	imm i"15" $r35
	nop/4
	lpassa $lr34 $ln0
	lpassa $mabid $lr42
	nop/24
	lxor $lr42 $ln0 $lr42
	nop/4
	lpassa $lr40 $ln0
	nop/24
	ior $lr42 $ln0 $lr40
	nop/4
	lpassa $lr32 $ln0
	nop/24
	lxor $lr40 $ln0 $omr2
	imm i"0" $r34
	imm i"3" $r35
	nop/4
	lpassa $lr34 $ln0
	lpassa $subpeid $lr40
	nop/24
	lxor $lr40 $ln0 $lr40
	nop/4
	imm i"0" $r34
	imm i"15" $r35
	nop/4
	lpassa $lr34 $ln0
	lpassa $mabid $lr42
	nop/24
	lxor $lr42 $ln0 $lr42
	nop/4
	lpassa $lr40 $ln0
	nop/24
	ior $lr42 $ln0 $lr40
	nop/4
	imm i"0" $r34
	imm i"7" $r35
	nop/4
	lpassa $lr34 $ln0
	lpassa $l1bid $lr42
	nop/24
	lxor $lr42 $ln0 $lr42
	nop/4
	lpassa $lr40 $ln0
	nop/24
	ior $lr42 $ln0 $lr40
	nop/4
	lpassa $lr32 $ln0
	nop/24
	lxor $lr40 $ln0 $omr3
	imm i"0" $r34
	imm i"3" $r35
	nop/4
	lpassa $lr34 $ln0
	lpassa $subpeid $lr40
	nop/24
	lxor $lr40 $ln0 $lr40
	nop/4
	imm i"0" $r34
	imm i"15" $r35
	nop/4
	lpassa $lr34 $ln0
	lpassa $mabid $lr42
	nop/24
	lxor $lr42 $ln0 $lr42
	nop/4
	lpassa $lr40 $ln0
	nop/24
	ior $lr42 $ln0 $lr40
	nop/4
	imm i"0" $r34
	imm i"7" $r35
	nop/4
	lpassa $lr34 $ln0
	lpassa $l1bid $lr42
	nop/24
	lxor $lr42 $ln0 $lr42
	nop/4
	lpassa $lr40 $ln0
	nop/24
	ior $lr42 $ln0 $lr40
	nop/4
	imm i"0" $r34
	imm i"7" $r35
	nop/4
	lpassa $lr34 $ln0
	lpassa $l2bid $lr42
	nop/24
	lxor $lr42 $ln0 $lr42
	nop/4
	lpassa $lr40 $ln0
	nop/24
	ior $lr42 $ln0 $lr40
	nop/4
	lpassa $lr32 $ln0
	nop/24
	lxor $lr40 $ln0 $omr4
	imm i"0" $r40
	imm i"1" $r41
	nop/4
  maskr 1
	ipassa $lr40 $lr200
  mask 0
	nop
	nop
	imm i"0" $r40
	imm i"4" $r41
	nop/4
  maskr 2
	ipassa $lr40 $lr200
  mask 0
	nop
	nop
	imm i"0" $r40
	imm i"16" $r41
	nop/4
  maskr 3
	ipassa $lr40 $lr200
  mask 0
	nop
	nop
	imm i"0" $r40
	imm i"256" $r41
	nop/4
  maskr 4
	ipassa $lr40 $lr200
  mask 0
	nop
	nop
# -- left flags --
	lpassa $lr32 $ln0
	lpassa $subpeid $lr40
	nop/24
	lxor $lr40 $ln0 $omr1
	lpassa $mabid $ln0
	nop/24
	ior $subpeid $ln0 $lr40
	nop/4
	lpassa $lr32 $ln0
	nop/24
	lxor $lr40 $ln0 $omr2
	lpassa $mabid $ln0
	nop/24
	ior $l1bid $ln0 $lr40
	nop/4
	lpassa $lr40 $ln0
	nop/24
	ior $subpeid $ln0 $lr40
	nop/4
	lpassa $lr32 $ln0
	nop/24
	lxor $lr40 $ln0 $omr3
	lpassa $mabid $ln0
	nop/24
	ior $l1bid $ln0 $lr40
	nop/4
	lpassa $lr40 $ln0
	nop/24
	ior $subpeid $ln0 $lr40
	nop/4
	lpassa $lr40 $ln0
	nop/24
	ior $l2bid $ln0 $lr40
	nop/4
	lpassa $lr32 $ln0
	nop/24
	lxor $lr40 $ln0 $omr4
	imm i"0" $r40
	imm i"2" $r41
	nop/4
  maskr 1
	ipassa $lr40 $lr200
  mask 0
	nop
	nop
	imm i"0" $r40
	imm i"8" $r41
	nop/4
  maskr 2
	ipassa $lr40 $lr200
  mask 0
	nop
	nop
	imm i"0" $r40
	imm i"32" $r41
	nop/4
  maskr 3
	ipassa $lr40 $lr200
  mask 0
	nop
	nop
	imm i"0" $r40
	imm i"512" $r41
	nop/4
  maskr 4
	ipassa $lr40 $lr200
  mask 0
	nop
	nop
	lpassa $lr200 $lr416
	nop
	nop
	nop/4

	# $lr416 → LM → @collect
	lpassa $lr416 $lm0
	nop/24
	@collect _flags to_param 8 size 1 $lm0
