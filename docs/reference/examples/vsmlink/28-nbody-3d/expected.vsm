	nop/2
	dvmulu $lr24 $ls2 $nowrite
	dvfmad $lr24 $ls2 $mauf $ln6
	nop/2
	lpassa $ln6 $lr24
	nop/2
	# ニュートン補正: y = y*(1.5 - 0.5*r2*y^2)
