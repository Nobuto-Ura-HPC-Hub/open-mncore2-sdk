# HW パス: PDM から mvb で全 8 L2BM、 l2bmb で全 64 L1BM へ (64 u64 の区画ごと)

# @broadcast _pj from_param 8 size 4 $lr16
# === @broadcast _pj: PDM $p20544 → 全 4096 PE $lr16 ===
	mvb/n64i3f $p20544@0 $lc0
	nop/2
	nop; wait i3f
	nop/5
	l2bmb $lc0 $lb0
# broadcast_use.vsm — @broadcast: L1BM に載っている値を PE に配る部分
# 毎回展開される。載っていなかった場合は直前に broadcast_load.vsm が展開されている
# L1BM の番地は区画の先頭ではなく要求された位置 (ずれは vsmlink が加える)


	nop/5
	l1bmp $lb0 $lr16v
	nop/24
	nop/24
	dvadd $lr16 -$lm0 $ln0
	nop/2
	dvadd $lr18 -$lm2 $ln2
	nop/2
	dvadd $lr20 -$lm4 $ln4
	nop/2
	dvmulu $ln0 $ln0 $nowrite
	dvfmad $ln0 $ln0 $mauf $ls0
	nop/2
	dvmulu $ln2 $ln2 $nowrite
	dvfmad $ln2 $ln2 $mauf $lr24
	nop/2
	dvadd $ls0 $lr24 $ln6
	nop/2
	dvmulu $ln4 $ln4 $nowrite
	dvfmad $ln4 $ln4 $mauf $ls0
	nop/2
	dvadd $ln6 $ls0 $lr24
	nop/2
	dvadd $lr24 $lm14 $ls0
	nop/2
	drsqrt $ls0 $lr24
	nop/4
	# ニュートン補正: y = y*(1.5 - 0.5*r2*y^2)
	dvmulu $lr24 $lr24 $nowrite
	dvfmad $lr24 $lr24 $mauf $ln6
	nop/2
	dvmulu $ls0 $ln6 $nowrite
	dvfmad $ls0 $ln6 $mauf $lr26
	nop/2
	dvmulu $lm16 $lr26 $nowrite
	dvfmad $lm16 $lr26 $mauf $ln6
	nop/2
	dvadd $lm18 -$ln6 $ls2
	nop/2
	dvmulu $lr24 $ls2 $nowrite
	dvfmad $lr24 $ls2 $mauf $ln6
	nop/2
	lpassa $ln6 $lr24
	nop/2
	# ニュートン補正: y = y*(1.5 - 0.5*r2*y^2)
	dvmulu $lr24 $lr24 $nowrite
	dvfmad $lr24 $lr24 $mauf $ln6
	nop/2
	dvmulu $ls0 $ln6 $nowrite
	dvfmad $ls0 $ln6 $mauf $lr26
	nop/2
	dvmulu $lm16 $lr26 $nowrite
	dvfmad $lm16 $lr26 $mauf $ln6
	nop/2
