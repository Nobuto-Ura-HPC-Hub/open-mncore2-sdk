# vsmlink.ninja — examples/ 共通ビルドルール
# 使い方: include ../scripts/vsmlink.ninja (examples/*/build.ninja から)
# sdk.ninja の include より後に記述すること (${sdk_root} を参照するため)

rule vsmlink
  command = vsmlink $vsm $param $out
  description = VSMLINK $out

rule verify_cmd
  command = diff -u $expected $actual && echo "OK: $actual matches expected"
  description = VERIFY $actual

rule asm3
  command = assemble3 $in --output-file $out
  description = ASM3 $out

rule asm3_loader
  command = assemble3 $in --output-file $stem --loader
  description = ASM3 [loader] $stem

rule cc
  command = gcc -Wall -Wextra -I${sdk_root}/include $cflags -c $in -o $out
  description = CC $out

rule link_exe
  command = g++ $in -o $out -L${sdk_root}/lib/emu-lib -L${sdk_root}/lib -lmnc2 -lgpfn3 -lstdc++ -lrt -lm -fopenmp
  description = LINK $out

rule test_emu_lib
  command = LD_LIBRARY_PATH=${sdk_root}/lib/emu-lib ./$in $args
  description = TEST [emu:lib] $in

rule test_device
  command = ./$in $args
  description = TEST [device] $in

rule test_usage
  command = echo "使い方: ninja test-emu-lib / ninja test-device"
  description = INFO

# fetch_data は examples/data の ninja を内側で起動する。同じ build.ninja の中で複数の fetch_data が並列に走ると、
# 内側の ninja が同時に同じ生成手順を走らせ、出力と .ninja_log を取り合って失敗する。深さ 1 の pool で 1 本ずつにする。
pool fetch_data_serial
  depth = 1

rule fetch_data
  # ../data/created/<bin> が未生成のときだけ ninja -C ../data を呼ぶ。生成済みなら写すだけで、ninja を起動しない
  # (lit は最初に examples/data を作るので、lit を並列に流しても、ここで examples/data の ninja が同時に動かない)。
  command = { test -f ../data/created/$bin || ninja -C ../data created/$bin >/dev/null; } && cp ../data/created/$bin $out
  description = FETCH $out
  pool = fetch_data_serial

rule clean
  command = rm -rf _build
  description = CLEAN
