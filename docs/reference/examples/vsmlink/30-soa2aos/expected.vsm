# ABI PFN3_SBY64
#
# SoA -> AoS 変換カーネル。collect の成分ごと (SoA) 出力を、device 上で粒子ごと (AoS) に
# 並べ替える。distribute size 4 で各 PE に struct {x,y,z,m} を載せ、MAB 内 4x4 転置
# (dmwrite/dmread) を挟み、collect size 4 で書き戻すと AoS で出る (粒子順は順列)。
# 並びは share/vsmlink/directives-spec.md の「@distribute_aos2soa / @collect_soa2aos」。
#
# 転置のミソ: dmwrite/dmread は src/dst 両方に v (サイクルインクリメント) が要る。
# 無いと全サイクル同番地に上書きで壊れる (dev manual 3.6.1.6)。
#
# distribute.vsm — @distribute テンプレート

	nop; wait i10
	nop/3
# @distribute _a from_param 8 size 4 $lm0    # SoA を読み、各 PE に {x,y,z,m} ($lm0,2,4,6)
# === @distribute _a: PDM $p0 → L2BM → L1BM → $lm0 ===
# (:pdm :directive "@distribute" :id "_a" :slot 8 :place :pdm0 :addr 0 :size 16384 :access :read)
	mvp/n512 $p0@0 $lc0@0.0
	mvp/n512 $p512@0 $lc0@0.1
	mvp/n512 $p1024@0 $lc0@1.0
	mvp/n512 $p1536@0 $lc0@1.1
	mvp/n512 $p2048@0 $lc0@2.0
	mvp/n512 $p2560@0 $lc0@2.1
	mvp/n512 $p3072@0 $lc0@3.0
	mvp/n512i3f $p3584@0 $lc0@3.1
	nop/2
	nop; wait i3f
	nop/5
	l2bmb@0 $lc0 $lb0
	l2bmb@1 $lc64 $lb0
	l2bmb@2 $lc128 $lb0
	l2bmb@3 $lc192 $lb0
	l2bmb@4 $lc256 $lb0
	l2bmb@5 $lc320 $lb0
	l2bmb@6 $lc384 $lb0
	l2bmb@7 $lc448 $lb0
	nop/5
	mvp/n512 $p4096@0 $lc512@0.0
	mvp/n512 $p4608@0 $lc512@0.1
	mvp/n512 $p5120@0 $lc512@1.0
	mvp/n512 $p5632@0 $lc512@1.1
	mvp/n512 $p6144@0 $lc512@2.0
	mvp/n512 $p6656@0 $lc512@2.1
	mvp/n512 $p7168@0 $lc512@3.0
	mvp/n512i3f $p7680@0 $lc512@3.1
	nop/2
	nop; wait i3f
	nop/5
	l2bmb@0 $lc512 $lb64
	l2bmb@1 $lc576 $lb64
	l2bmb@2 $lc640 $lb64
	l2bmb@3 $lc704 $lb64
	l2bmb@4 $lc768 $lb64
	l2bmb@5 $lc832 $lb64
	l2bmb@6 $lc896 $lb64
	l2bmb@7 $lc960 $lb64
	nop/5
	mvp/n512 $p8192@0 $lc1024@0.0
	mvp/n512 $p8704@0 $lc1024@0.1
	mvp/n512 $p9216@0 $lc1024@1.0
	mvp/n512 $p9728@0 $lc1024@1.1
	mvp/n512 $p10240@0 $lc1024@2.0
	mvp/n512 $p10752@0 $lc1024@2.1
	mvp/n512 $p11264@0 $lc1024@3.0
	mvp/n512i3f $p11776@0 $lc1024@3.1
	nop/2
	nop; wait i3f
	nop/5
	l2bmb@0 $lc1024 $lb128
	l2bmb@1 $lc1088 $lb128
	l2bmb@2 $lc1152 $lb128
	l2bmb@3 $lc1216 $lb128
	l2bmb@4 $lc1280 $lb128
	l2bmb@5 $lc1344 $lb128
	l2bmb@6 $lc1408 $lb128
	l2bmb@7 $lc1472 $lb128
	nop/5
	mvp/n512 $p12288@0 $lc1536@0.0
	mvp/n512 $p12800@0 $lc1536@0.1
	mvp/n512 $p13312@0 $lc1536@1.0
	mvp/n512 $p13824@0 $lc1536@1.1
	mvp/n512 $p14336@0 $lc1536@2.0
	mvp/n512 $p14848@0 $lc1536@2.1
	mvp/n512 $p15360@0 $lc1536@3.0
	mvp/n512i3f $p15872@0 $lc1536@3.1
	nop/2
	nop; wait i3f
	nop/5
	l2bmb@0 $lc1536 $lb192
	l2bmb@1 $lc1600 $lb192
	l2bmb@2 $lc1664 $lb192
	l2bmb@3 $lc1728 $lb192
	l2bmb@4 $lc1792 $lb192
	l2bmb@5 $lc1856 $lb192
	l2bmb@6 $lc1920 $lb192
	l2bmb@7 $lc1984 $lb192
	nop/5
	l1bmd $lb0 $lm0v
	nop/24
	nop/24
	dmwrite $lm0v $lx0                          # MAB 内 4x4 転置 (書き込み、v 必須)
	nop/24
	dmread  $lx0 $lm8v                          # 転置読み出し (dst も v 必須)
	nop/24
# collect.vsm — @collect テンプレート

# @collect _b to_param 16 size 4 $lm8         # AoS で PDM へ
# === @collect _b: $lm8 → L1BM → L2BM → PDM $p131072 ===
# (:pdm :directive "@collect" :id "_b" :slot 16 :place :pdm0 :addr 131072 :size 16384 :access :write)
	nop/24
	l1bmd $lm8v $lb0
	nop/24
	l2bm@0 $lb0 $lc0
	l2bm@1 $lb0 $lc64
	l2bm@2 $lb0 $lc128
	l2bm@3 $lb0 $lc192
	l2bm@4 $lb0 $lc256
	l2bm@5 $lb0 $lc320
	l2bm@6 $lb0 $lc384
	l2bm@7 $lb0 $lc448
	nop/5
	mvp/n512 $lc0@0.0 $p131072@0
	mvp/n512i3f $lc0@0.1 $p131584@0
	nop/3
	nop; wait i3f
	mvp/n512 $lc0@1.0 $p132096@0
	mvp/n512i3f $lc0@1.1 $p132608@0
	nop/3
	nop; wait i3f
	mvp/n512 $lc0@2.0 $p133120@0
	mvp/n512i3f $lc0@2.1 $p133632@0
	nop/3
	nop; wait i3f
	mvp/n512 $lc0@3.0 $p134144@0
	mvp/n512i3f $lc0@3.1 $p134656@0
	nop/3
	nop; wait i3f
	l2bm@0 $lb64 $lc512
	l2bm@1 $lb64 $lc576
	l2bm@2 $lb64 $lc640
	l2bm@3 $lb64 $lc704
	l2bm@4 $lb64 $lc768
