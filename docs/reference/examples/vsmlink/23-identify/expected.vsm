# ABI PFN3_SBY64
#
# test1_identify: test1 の @identify 版
#   @identify 0 $lr8 4096 で PE ID を直接 $lr8 に配布
#   偶数PE → 0, 奇数PE → 配布値 を @collect
#
# test1._vsm との差分:
#   @distribute _idbuf from_param 8 size 1 $lm0 → @identify 0 $lr8 4096
#   $lm0 経由の lpassa $lm0 $lr8 は不要（直接 $lr8 に配布）
#
# レジスタ (test1._vsm と同じ割り当て):
#   $lr8  — 配布値 (identify で直接書き込み)
#   ln0   — 定数 1
#   $lr16 — 配布値 & 1
#   omr15 — NOT(配布値 & 1)
#   $lr24 — 結果
#   $lm16 — 結果 collect 用
#
# distribute.vsm — @distribute テンプレート

	nop; wait i10
	nop/3
# @identify 0 $lr8 4096
# === @identify 0: PDM $p0 → L2BM → L1BM → $lr8 ===
	mvp/n512 $p0@0 $lc0@0.0
	mvp/n512 $p512@0 $lc0@0.1
	mvp/n512 $p1024@0 $lc0@1.0
	mvp/n512 $p1536@0 $lc0@1.1
	mvp/n512 $p2048@0 $lc0@2.0
	mvp/n512 $p2560@0 $lc0@2.1
	mvp/n512 $p3072@0 $lc0@3.0
	mvp/n512i3f $p3584@0 $lc0@3.1
	nop/2
	nop; wait i3f
	nop/5
	l2bmb@0 $lc0 $lb0
	l2bmb@1 $lc64 $lb0
	l2bmb@2 $lc128 $lb0
	l2bmb@3 $lc192 $lb0
	l2bmb@4 $lc256 $lb0
	l2bmb@5 $lc320 $lb0
	l2bmb@6 $lc384 $lb0
	l2bmb@7 $lc448 $lb0
	nop/5
	l1bmd $lb0 $lr8v/1000
# 定数 1 → ln0
	nop/24
	imm i"0" $r0
	imm i"1" $r1
	nop/4
	lpassa $lr0 $ln0
	nop/24
# 配布値 & 1 → lr16 (0=偶数, 1=奇数)
	iand $ln0 $lr8 $lr16
	nop/4
# NOT(配布値 & 1) → omr15 (0=奇数PE → maskr active)
	lxor $ln0 $lr16 $omr15
	nop
	nop
# 結果 = 0 (偶数PE のデフォルト)
	imm i"0" $r24
	imm i"0" $r25
	nop
	nop
# 奇数PE のみ: 結果 = 配布値
	  maskr 15
	ipassa $lr8 $lr24
	  mask 0
	nop
	nop
	lpassa $lr24 $lm16
	nop
	nop
	nop/24
# collect.vsm — @collect テンプレート

# @collect _out to_param 24 size 1 $lm16
# === @collect _out: $lm16 → L1BM → L2BM → PDM $p8192 ===
# (:pdm :directive "@collect" :id "_out" :slot 24 :place :pdm0 :addr 8192 :size 4096 :access :write)
	nop/24
	l1bmd $lm16v $lb0
	nop/24
	l2bm@0 $lb0 $lc0
	l2bm@1 $lb0 $lc64
	l2bm@2 $lb0 $lc128
	l2bm@3 $lb0 $lc192
	l2bm@4 $lb0 $lc256
	l2bm@5 $lb0 $lc320
	l2bm@6 $lb0 $lc384
	l2bm@7 $lb0 $lc448
	nop/5
	mvp/n512 $lc0@0.0 $p8192@0
	mvp/n512i3f $lc0@0.1 $p8704@0
	nop/3
	nop; wait i3f
	mvp/n512 $lc0@1.0 $p9216@0
	mvp/n512i3f $lc0@1.1 $p9728@0
	nop/3
	nop; wait i3f
	mvp/n512 $lc0@2.0 $p10240@0
	mvp/n512i3f $lc0@2.1 $p10752@0
	nop/3
	nop; wait i3f
	mvp/n512 $lc0@3.0 $p11264@0
	mvp/n512i1e $lc0@3.1 $p11776@0
	nop/3
	nop; wait i1e
	nop/4
