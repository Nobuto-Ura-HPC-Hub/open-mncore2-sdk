# boundary-collect: 各 PE の $subpeid / $mabid / $l1bid をホスト側に回収する
#
# 目的: @boundary_flags distribute 版の初回フラグ値生成バイナリ。
#       このバイナリをハードウェア上で一度実行すると、各 PE の HW レジスタ値が
#       PDM に集まる。ホスト側でそれを読み出して、次回以降の distribute に使う。
#
# 出力:
#   to_param 8:  $subpeid の値 (4096 PE × 1 LW)  — 0..3
#   to_param 16: $mabid の値  (4096 PE × 1 LW)  — 0..15
#   to_param 24: $l1bid の値  (4096 PE × 1 LW)  — 0..7
#
# 注意: vsmlink コマンド本体の改造なし。lpassa + @collect のみ使用。

	# $subpeid を GRF 経由で LM に格納
	lpassa $subpeid $lr0
	nop
	nop
	lpassa $lr0 $lm0
	nop/24
# collect.vsm — @collect テンプレート

# @collect _subpeid to_param 8 size 1 $lm0
# === @collect _subpeid: $lm0 → L1BM → L2BM → PDM $p0 ===
# (:pdm :directive "@collect" :id "_subpeid" :slot 8 :place :pdm0 :addr 0 :size 4096 :access :write)
	nop/24
	l1bmd $lm0v $lb0
	nop/24
	l2bm@0 $lb0 $lc0
	l2bm@1 $lb0 $lc64
	l2bm@2 $lb0 $lc128
	l2bm@3 $lb0 $lc192
	l2bm@4 $lb0 $lc256
	l2bm@5 $lb0 $lc320
	l2bm@6 $lb0 $lc384
	l2bm@7 $lb0 $lc448
	nop/5
	mvp/n512 $lc0@0.0 $p0@0
	mvp/n512i3f $lc0@0.1 $p512@0
	nop/3
	nop; wait i3f
	mvp/n512 $lc0@1.0 $p1024@0
	mvp/n512i3f $lc0@1.1 $p1536@0
	nop/3
	nop; wait i3f
	mvp/n512 $lc0@2.0 $p2048@0
	mvp/n512i3f $lc0@2.1 $p2560@0
	nop/3
	nop; wait i3f
	mvp/n512 $lc0@3.0 $p3072@0
	mvp/n512i1e $lc0@3.1 $p3584@0
	nop/3
	nop; wait i1e
	nop/4

	# $mabid を GRF 経由で LM に格納
	lpassa $mabid $lr0
	nop
	nop
	lpassa $lr0 $lm8
	nop/24
# collect.vsm — @collect テンプレート

# @collect _mabid to_param 16 size 1 $lm8
# === @collect _mabid: $lm8 → L1BM → L2BM → PDM $p4096 ===
# (:pdm :directive "@collect" :id "_mabid" :slot 16 :place :pdm0 :addr 4096 :size 4096 :access :write)
	nop/24
	l1bmd $lm8v $lb0
	nop/24
	l2bm@0 $lb0 $lc0
	l2bm@1 $lb0 $lc64
	l2bm@2 $lb0 $lc128
	l2bm@3 $lb0 $lc192
	l2bm@4 $lb0 $lc256
	l2bm@5 $lb0 $lc320
	l2bm@6 $lb0 $lc384
	l2bm@7 $lb0 $lc448
	nop/5
	mvp/n512 $lc0@0.0 $p4096@0
	mvp/n512i3f $lc0@0.1 $p4608@0
	nop/3
	nop; wait i3f
	mvp/n512 $lc0@1.0 $p5120@0
	mvp/n512i3f $lc0@1.1 $p5632@0
	nop/3
	nop; wait i3f
	mvp/n512 $lc0@2.0 $p6144@0
	mvp/n512i3f $lc0@2.1 $p6656@0
	nop/3
	nop; wait i3f
	mvp/n512 $lc0@3.0 $p7168@0
	mvp/n512i1f $lc0@3.1 $p7680@0
	nop/3
	nop; wait i1f
	nop/4

	# $l1bid を GRF 経由で LM に格納
	lpassa $l1bid $lr0
	nop
	nop
	lpassa $lr0 $lm16
	nop/24
# collect.vsm — @collect テンプレート

# @collect _l1bid to_param 24 size 1 $lm16
# === @collect _l1bid: $lm16 → L1BM → L2BM → PDM $p8192 ===
# (:pdm :directive "@collect" :id "_l1bid" :slot 24 :place :pdm0 :addr 8192 :size 4096 :access :write)
	nop/24
	l1bmd $lm16v $lb0
	nop/24
	l2bm@0 $lb0 $lc0
	l2bm@1 $lb0 $lc64
	l2bm@2 $lb0 $lc128
	l2bm@3 $lb0 $lc192
	l2bm@4 $lb0 $lc256
	l2bm@5 $lb0 $lc320
	l2bm@6 $lb0 $lc384
	l2bm@7 $lb0 $lc448
	nop/5
	mvp/n512 $lc0@0.0 $p8192@0
	mvp/n512i3f $lc0@0.1 $p8704@0
	nop/3
	nop; wait i3f
	mvp/n512 $lc0@1.0 $p9216@0
	mvp/n512i3f $lc0@1.1 $p9728@0
	nop/3
	nop; wait i3f
	mvp/n512 $lc0@2.0 $p10240@0
	mvp/n512i3f $lc0@2.1 $p10752@0
	nop/3
	nop; wait i3f
	mvp/n512 $lc0@3.0 $p11264@0
	mvp/n512i20 $lc0@3.1 $p11776@0
	nop/3
	nop; wait i20
	nop/4
